{
	// Enable format on save
	"editor.formatOnSave": true,

	// Set Prettier as default formatter
	"editor.defaultFormatter": "esbenp.prettier-vscode",

	// Format specific file types on save
	"[javascript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[typescript]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[json]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},
	"[jsonc]": {
		"editor.defaultFormatter": "esbenp.prettier-vscode",
		"editor.formatOnSave": true
	},

	// Prettier configuration
	"prettier.requireConfig": true,
	"prettier.useEditorConfig": false,

	// Auto-fix on save - Run in specific order
	"editor.codeActionsOnSave": {
		"source.organizeImports": "never",
		"source.fixAll.eslint": "explicit"
	},

	// Disable auto import organization (conflicts with Prettier)
	"typescript.preferences.organizeImportsOnSave": false,
	"javascript.preferences.organizeImportsOnSave": false
}
