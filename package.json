{
	"name": "bnpi-pats-api",
	"version": "1.0.122",
	"main": "dist/lib-entry.js",
	"scripts": {
		"prepare": "husky",
		"dev": "dotenv tsx watch index.ts",
		"start": "dotenv tsx index.ts",
		"lint": "eslint app/**/*.ts index.ts",
		"format": "eslint app/**/*.ts index.ts --fix",
		"type-check": "tsc --noEmit && echo Type check passed!",
		"test": "mocha --require ts-node/register tests/**/*.spec.ts",
		"postinstall": "prisma generate && prisma generate --schema prisma/pats/schema.prisma",
		"build": "prisma generate && prisma generate --schema prisma/pats/schema.prisma && webpack --config webpack.config.js && node -e \"require('fs').cpSync('generated', 'dist/generated', {recursive: true})\"",
		"prod": "node dist/server.js",
		"export-docs": "ts-node scripts/generate-openapi.ts && ts-node scripts/export-openapi.ts && npx --yes openapi-to-postmanv2 -s docs/generated/swagger.json -o docs/generated/postman.collection.json -p",
		"prisma-docs": "npx prisma studio",
		"prisma-migrate": "npx prisma migrate dev",
		"prisma-generate": "npx prisma generate",
		"prisma-format": "npx prisma format",
		"prisma:pats:format": "node scripts/pats-prisma-format.mjs",
		"prisma:pats:validate": "node scripts/pats-prisma-validate.mjs",
		"prisma:pats:generate": "node scripts/pats-prisma-generate.mjs",
		"prisma:pats:bootstrap-local-admin": "node scripts/pats-bootstrap-local-admin.mjs",
		"prisma:pats:migrate:dev": "node scripts/pats-prisma-migrate-dev.mjs",
		"prisma:pats:migrate:deploy": "node scripts/pats-prisma-migrate-deploy.mjs",
		"prisma-seed": "npx prisma db seed",
		"prisma-reset": "npx prisma migrate reset --force",
		"copy-codebase": "ts-node scripts/copy-codebase.ts",
		"generate": "ts-node scripts/generate-and-export.ts",
		"api-list": "curl -X GET 'http://localhost:3000/api/docs/api-list?format=json' | jq",
		"zod-generate": "node scripts/zod-generate.js"
	},
	"prisma": {
		"seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts",
		"schema": "prisma/schema"
	},
	"author": "1BIS",
	"license": "MIT",
	"description": "Backend API for Bandai PATS, built with TypeScript, Express, Prisma (MongoDB), and supporting tools for validation, reporting, and documentation.",
	"keywords": [
		"typescript",
		"express",
		"prisma",
		"api",
		"restful",
		"authentication",
		"microservice",
		"template",
		"scaffolding",
		"mongodb",
		"zod",
		"swagger",
		"openapi",
		"query-utils",
		"logging"
	],
	"engines": {
		"node": "20.x"
	},
	"packageManager": "pnpm@10.25.0",
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1085.0",
		"@aws-sdk/s3-request-presigner": "^3.1085.0",
		"@logtail/node": "^0.5.8",
		"@logtail/winston": "^0.5.8",
		"@prisma/client": "^6.19.0",
		"@types/cookie-parser": "^1.4.8",
		"@types/express": "^5.0.1",
		"@types/jsonwebtoken": "^9.0.9",
		"@types/multer": "^1.4.13",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"argon2": "^0.41.1",
		"cloudinary": "^2.10.0",
		"cookie-parser": "^1.4.7",
		"dotenv": "^16.4.7",
		"express": "^5.1.0",
		"express-rate-limit": "^7.4.1",
		"express-slow-down": "^2.0.3",
		"helmet": "^8.1.0",
		"http": "^0.0.1-security",
		"ioredis": "^5.7.0",
		"jsonwebtoken": "^9.0.3",
		"mongoose": "^8.22.1",
		"multer": "^2.2.0",
		"node-cron": "^4.2.1",
		"pdfmake": "^0.3.11",
		"prisma": "^6.19.0",
		"socket.io": "^4.8.3",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1",
		"ts-loader": "^9.5.2",
		"validator": "^13.12.0",
		"webpack": "^5.108.3",
		"webpack-cli": "^5.1.4",
		"winston": "^3.17.0",
		"xlsx": "^0.18.5",
		"zod": "^3.25.67"
	},
	"devDependencies": {
		"@types/chai": "^5.2.1",
		"@types/cors": "^2.8.18",
		"@types/express-slow-down": "^1.0.0",
		"@types/ioredis": "^4.28.10",
		"@types/mocha": "^10.0.10",
		"@types/mongodb": "^4.0.6",
		"@types/node": "^22.14.0",
		"@types/pdfmake": "^0.3.3",
		"@types/supertest": "^6.0.3",
		"@types/validator": "^13.12.0",
		"@types/yaml": "^1.9.6",
		"@typescript-eslint/eslint-plugin": "^8.29.0",
		"@typescript-eslint/parser": "^8.29.0",
		"chai": "^4.5.0",
		"dotenv-cli": "^8.0.0",
		"eslint": "^9.24.0",
		"eslint-config-prettier": "^10.1.1",
		"eslint-plugin-import": "^2.31.0",
		"eslint-plugin-prettier": "^5.2.6",
		"husky": "^9.1.7",
		"mocha": "^11.1.0",
		"mongodb": "^6.16.0",
		"nodemon": "^3.1.9",
		"npm": "^11.2.0",
		"rimraf": "^6.0.1",
		"supertest": "^7.1.4",
		"ts-node": "^10.9.2",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"yaml": "^2.9.0"
	}
}
