enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
  DISPUTED
}

enum InvoiceType {
  PAYABLE // Invoice from vendor (we need to pay)
  RECEIVABLE // Invoice to customer (we receive payment)
}

// Composite type for invoice line items
type InvoiceItem {
  itemId      String? @db.ObjectId // Reference to Item (optional)
  description String // Item/service description
  quantity    Int // Quantity
  unitPrice   Float // Price per unit
  totalPrice  Float // quantity * unitPrice
  taxable     Boolean @default(true) // Whether this item is taxable
  remarks     String? // Additional notes
}

// Composite type for payment records
type InvoicePayment {
  paymentId       String?  @db.ObjectId // Reference to Transaction (optional)
  paymentDate     DateTime // Date of payment
  amount          Float // Payment amount
  paymentMethod   String? // e.g., "CHECK", "BANK_TRANSFER"
  referenceNumber String? // Payment reference
  remarks         String? // Notes about the payment
}

model Invoice {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  invoiceNumber String @unique // e.g., "INV-2025-001"

  // Invoice type
  invoiceType InvoiceType @default(PAYABLE)

  // Purchase Order relationship (optional)
  purchaseOrderId String?        @db.ObjectId
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // Delivery Order relationship (optional)
  deliveryOrderId String?        @db.ObjectId
  deliveryOrder   DeliveryOrder? @relation(fields: [deliveryOrderId], references: [id])

  // Vendor relationship (required for PAYABLE invoices)
  vendorId String? @db.ObjectId
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  // Project relationship (optional)
  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  // Party details (for cases where vendor is not in system)
  partyName    String? // Vendor/Customer name if not using vendorId
  partyAddress String?
  partyContact String?
  partyEmail   String?

  // Dates
  invoiceDate DateTime  @default(now()) // Date invoice was issued
  dueDate     DateTime? // Payment due date
  paidDate    DateTime? // Date invoice was fully paid

  // Line items
  items InvoiceItem[]

  // Financial summary
  subtotal       Float  @default(0) // Sum of all item totals
  taxPercentage  Float? // Tax percentage (e.g., 12 for 12%)
  taxAmount      Float  @default(0) // Calculated tax amount
  discountAmount Float  @default(0) // Discount amount
  totalAmount    Float  @default(0) // Final total (subtotal + tax - discount)
  currency       String @default("PHP")

  // Payment tracking
  paidAmount     Float            @default(0) // Total amount paid so far
  balanceDue     Float            @default(0) // Remaining balance (totalAmount - paidAmount)
  paymentTerms   String? // e.g., "Net 30", "Due on Receipt"
  paymentRecords InvoicePayment[] // History of payments

  // Status tracking
  status  InvoiceStatus @default(DRAFT)
  remarks String?

  // Document attachments (invoice PDF, receipts, etc.)
  documentUrls String[] @default([])

  // Audit fields
  sentAt         DateTime? // When invoice was sent
  acknowledgedAt DateTime? // When invoice was acknowledged
  acknowledgedBy String? // Who acknowledged the invoice

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([purchaseOrderId])
  @@index([deliveryOrderId])
  @@index([vendorId])
  @@index([projectId])
  @@index([status])
  @@index([invoiceType])
  @@index([invoiceDate])
  @@index([dueDate])
}
