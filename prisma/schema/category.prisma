enum CategoryType {
  CAPEX
  OPEX
}

model Category {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  name        String
  code        String?      @db.String // 3-character unique code (e.g., "MTR", "LBR", "EQP")
  description String?
  color       String?
  type        CategoryType

  isActive Boolean @default(true)

  // Project relationship - array allows categories to be shared across projects
  projectIds String[] @default([]) @db.ObjectId

  // Relationships
  items  Item[]
  fields Field[] // Category-specific fields (e.g., "Human Resource" has "Employee" field)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, projectIds])
  @@index([workspaceId])
  @@index([isActive])
  @@index([projectIds])
}
