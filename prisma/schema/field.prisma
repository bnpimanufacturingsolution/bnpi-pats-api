enum FieldType {
  singletext
  multitext
  number
  date
  singleselect
  multipleselect
  iteration
  user
  employee // Reference to Employee entity
  calculated
  item
  object
}

enum FieldCategory {
  common
  custom
}

model Field {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  name        String        @db.String
  label       String?       @db.String // Display label (e.g., "Assigned Employee")
  type        FieldType
  category    FieldCategory
  value       Json? // Default value or config (e.g., options for select)
  placeholder String?       @db.String // Placeholder text for inputs
  required    Boolean       @default(false)
  sortOrder   Int           @default(0) // Field display order

  // Link to ItemType (for item-type-specific fields)
  itemTypeId String?   @db.ObjectId
  itemType   ItemType? @relation(fields: [itemTypeId], references: [id])

  // Link to Category (for category-specific fields)
  categoryId String?   @db.ObjectId
  category_  Category? @relation(fields: [categoryId], references: [id])

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([category])
  @@index([type])
  @@index([name])
  @@index([categoryId])
  @@index([itemTypeId])
}
