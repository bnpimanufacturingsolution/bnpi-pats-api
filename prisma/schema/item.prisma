enum ItemStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Composite type for field values
type FieldValue {
  fieldId String @db.ObjectId
  value   Json
}

// Composite type for item fields structure
type ItemFields {
  common FieldValue[]
  custom FieldValue[]
}

model Item {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  // Estimation relationship (required)
  estimationId String     @db.ObjectId
  estimation   Estimation @relation(fields: [estimationId], references: [id], onDelete: Cascade)

  categoryId String?   @db.ObjectId // Optional: Category reference (mainly for OPEX)
  category   Category? @relation(fields: [categoryId], references: [id])

  itemTypeId String?   @db.ObjectId // Optional: ItemType reference (e.g., CAPEX, OPEX, MISC)
  itemType   ItemType? @relation(fields: [itemTypeId], references: [id])

  milestoneId String?    @db.ObjectId // Optional: Milestone reference for tracking deliverables
  milestone   Milestone? @relation(fields: [milestoneId], references: [id])

  itemName String // "Laptop", "Van", "PM", "Monitor", etc.

  estimatedQuantity  Int // Estimated quantity
  actualQuantity     Int? // Actual quantity purchased/used
  estimatedUnitPrice Float
  estimatedTotal     Float
  actualUnitPrice    Float?
  actualTotal        Float?
  documentUrls       String[] @default([])
  metadata           Json?

  // Dynamic fields with references to Field model
  fields ItemFields?

  // Status and timeline
  status    ItemStatus @default(PENDING)
  startDate DateTime?
  endDate   DateTime?

  // Estimation points (Fibonacci: 1, 2, 3, 5, 8, 13, 21, etc.)
  estimationPoints Int? // Optional - complexity/effort estimation using Fibonacci sequence

  // References
  orderId String? @db.ObjectId
  order   Order?  @relation(fields: [orderId], references: [id])

  // Purchase Order relationship (optional - when PO is created from this item)
  purchaseOrderId String?        @db.ObjectId
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  // Track if item was added to an already active estimation
  isNewAddition Boolean @default(false)

  // Self-referencing for item hierarchy (optional)
  parentItemId String? @db.ObjectId
  parentItem   Item?   @relation("ItemHierarchy", fields: [parentItemId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  childItems   Item[]  @relation("ItemHierarchy")

  // Transactions - payments made for this specific item (OUTGOING transactions)
  transactions Transaction[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([estimationId])
  @@index([categoryId])
  @@index([itemTypeId])
  @@index([milestoneId])
  @@index([parentItemId])
  @@index([purchaseOrderId])
}
