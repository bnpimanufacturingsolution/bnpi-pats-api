enum EstimationStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REVISED
}

model Estimation {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  estimationNumber String @unique // e.g., "EST-2025-001"
  name             String // e.g., "Initial Estimate", "Revised Proposal"
  version          Int    @default(1) // Version number, increments with each new version

  // Project relationship
  projectId String  @db.ObjectId
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Financial Data (Source/Input only)
  marginPercentage Float // User input - e.g., 30.00 for 30%

  // Status
  status EstimationStatus @default(DRAFT)

  // Relationships
  items          Item[]
  orders         Order[]
  payslips       Payslip[]
  milestones     Milestone[]
  purchaseOrders PurchaseOrder[]
  paymentTerms   PaymentTerm[]

  // Additional fields
  notes      String?
  metaData   Json? // Computed/cached values - recompute on transaction changes
  // metaData contains:
  // - estimatedCost: Float (SUM of item.estimatedTotal)
  // - actualCost: Float (SUM of cleared transactions)
  // - marginAmount: Float (estimatedCost * marginPercentage / 100)
  // - projectedWithMargin: Float (estimatedCost + marginAmount)
  // - allocatedAmount: Float (SUM of all transactions)
  // - remainingAmount: Float (estimatedCost - allocatedAmount)
  // - categorySubtotals: Object (by category)
  // - typeBreakdown: Object (CAPEX/OPEX/MISC)
  // - lastComputedAt: DateTime
  approvedBy String? // User ID who approved
  approvedAt DateTime?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([projectId])
  @@index([status])
}
