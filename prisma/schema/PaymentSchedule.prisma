enum PaymentScheduleStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

// Composite type for payment term installment definitions
type PaymentTermInstallment {
  sequence            Int // Order of installment (1, 2, 3...)
  percentage          Float // Percentage of total (e.g., 50.0 for 50%)
  dueDaysFromApproval Int // Days from PO approval date until due (0 for immediate)
  description         String // e.g., "Deposit", "Progress Payment", "Final Payment"
}

// Composite type for individual payment schedule line items
type PaymentScheduleItem {
  sequence       Int // Order of payment (1, 2, 3...)
  description    String // e.g., "Deposit", "Progress Payment 1", "Final Payment"
  percentage     Float // Percentage of PO total
  amount         Float // Computed amount from PO totalAmount
  dueDate        DateTime // Computed from PO approval date + installment dueDays
  status         String // UPCOMING | DUE | PARTIAL | PAID | OVERDUE | CANCELLED
  paidAmount     Float // Sum of released payments for this item
  balance        Float // amount - paidAmount
  transactionIds String[] // IDs of transactions linked to this item
}

model PaymentSchedule {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String?

  // One schedule per PO
  purchaseOrderId String        @unique @db.ObjectId
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])

  // Reference to the payment term used to generate this schedule
  paymentTermId String? @db.ObjectId

  // Schedule line items
  items PaymentScheduleItem[]

  // Financial summary
  totalScheduled Float // Sum of all item amounts (should equal PO totalAmount)
  totalPaid      Float @default(0) // Sum of all paid amounts
  balance        Float // totalScheduled - totalPaid

  status PaymentScheduleStatus @default(ACTIVE)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([status])
}
