model Vendor {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  vendorId           String  @unique // e.g., "V001"
  name               String
  contactPerson      String?
  contactDesignation String? // Contact person designation (e.g., "Sales")
  contactDepartment  String? // Contact person department (e.g., "Sales")
  email              String?
  phone              String?
  mobile             String? // Contact mobile number
  address            String?
  notes              String?

  // Relationships
  orders         Order[]
  purchaseOrders PurchaseOrder[]
  deliveryOrders DeliveryOrder[]
  invoices       Invoice[]
  isDeleted      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workspaceId])
}
