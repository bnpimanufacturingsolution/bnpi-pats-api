enum WorkspaceStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Workspace {
  id             String          @id @default(auto()) @map("_id") @db.ObjectId
  organizationId String? // External organization ID from login/authentication system
  name           String
  code           String          @unique
  description    String?
  address        String? // Company address for documents
  phone          String? // Company phone number
  email          String? // Company email
  logoUrl        String? // Company logo URL for documents
  status         WorkspaceStatus @default(ACTIVE)
  isPinned       Boolean         @default(false)

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  employees                  Employee[]
  workspaceMembers           WorkspaceMember[]
  projectMembers             ProjectMember[]
  products                   Product[]
  productSteps               ProductProductionStep[]
  productMaterials           ProductMaterial[]
  productCostAssumptions     ProductCostAssumption[]

  @@index([status])
}
