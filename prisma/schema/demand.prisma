enum DemandPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISED
  CONVERTED_TO_PROJECT
  ARCHIVED
}

enum DemandEstimateVersionStatus {
  DRAFT
  CALCULATED
  APPROVED
  REJECTED
  REVISED
  ARCHIVED
}

enum ProjectConversionStatus {
  PENDING
  READY
  COMPLETED
  FAILED
  CANCELLED
}

model DemandPlan {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  planCode    String
  name        String
  description String?
  periodLabel String?
  periodStart DateTime
  periodEnd   DateTime
  status      DemandPlanStatus @default(DRAFT)
  metadata    Json?
  notes       String?

  demandLines        DemandLine[]
  estimateVersions   DemandEstimateVersion[]
  projectConversions ProjectConversion[]

  isDeleted                  Boolean                     @default(false)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  demandEstimateLines        DemandEstimateLine[]
  demandMaterialRequirements DemandMaterialRequirement[]
  demandLaborRequirements    DemandLaborRequirement[]

  @@unique([workspaceId, planCode])
  @@index([workspaceId])
  @@index([status])
  @@index([periodStart])
  @@index([periodEnd])
}

model DemandLine {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  lineNo             Int
  productCode        String
  productName        String
  productRevision    String?
  unitOfMeasure      String
  quantity           Int
  targetDeliveryDate DateTime?
  priority           Int?
  productSnapshot    Json?
  notes              String?

  demandEstimateLines DemandEstimateLine[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandPlanId, lineNo])
  @@index([workspaceId])
  @@index([demandPlanId])
  @@index([productId])
}

model DemandEstimateVersion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  versionNumber Int
  versionLabel  String?
  status        DemandEstimateVersionStatus @default(DRAFT)
  metadata      Json?
  notes         String?

  demandEstimateLines        DemandEstimateLine[]
  demandMaterialRequirements DemandMaterialRequirement[]
  demandLaborRequirements    DemandLaborRequirement[]
  projectConversion          ProjectConversion?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandPlanId, versionNumber])
  @@index([workspaceId])
  @@index([demandPlanId])
  @@index([status])
}

model DemandEstimateLine {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  demandEstimateVersionId String                @db.ObjectId
  demandEstimateVersion   DemandEstimateVersion @relation(fields: [demandEstimateVersionId], references: [id], onDelete: Cascade)

  demandLineId String     @db.ObjectId
  demandLine   DemandLine @relation(fields: [demandLineId], references: [id])

  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id])

  lineNo            Int
  productCode       String
  productName       String
  productRevision   String?
  unitOfMeasure     String
  requestedQuantity Int
  estimatedQuantity Int?
  productSnapshot   Json?
  notes             String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandEstimateVersionId, lineNo])
  @@index([workspaceId])
  @@index([demandEstimateVersionId])
  @@index([demandLineId])
  @@index([productId])
}

model DemandMaterialRequirement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  demandEstimateVersionId String                @db.ObjectId
  demandEstimateVersion   DemandEstimateVersion @relation(fields: [demandEstimateVersionId], references: [id], onDelete: Cascade)

  lineNo                Int
  materialCode          String?
  materialName          String
  materialType          String?
  quantityPerUnit       Float
  totalRequiredQuantity Float
  unitOfMeasure         String
  scrapRatePercentage   Float   @default(0)
  isOptional            Boolean @default(false)
  sourceLabel           String?
  materialSnapshot      Json?
  notes                 String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandEstimateVersionId, lineNo])
  @@index([workspaceId])
  @@index([demandEstimateVersionId])
  @@index([materialCode])
}

model DemandLaborRequirement {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  demandEstimateVersionId String                @db.ObjectId
  demandEstimateVersion   DemandEstimateVersion @relation(fields: [demandEstimateVersionId], references: [id], onDelete: Cascade)

  lineNo         Int
  stepName       String
  workCenter     String?
  stepOrder      Int?
  laborHours     Float
  crewSize       Int?
  ratePerHour    Float?
  totalLaborCost Float?
  sourceLabel    String?
  laborSnapshot  Json?
  notes          String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([demandEstimateVersionId, lineNo])
  @@index([workspaceId])
  @@index([demandEstimateVersionId])
  @@index([workCenter])
}

model ProjectConversion {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  demandPlanId String     @db.ObjectId
  demandPlan   DemandPlan @relation(fields: [demandPlanId], references: [id], onDelete: Cascade)

  demandEstimateVersionId String                @unique @db.ObjectId
  demandEstimateVersion   DemandEstimateVersion @relation(fields: [demandEstimateVersionId], references: [id], onDelete: Cascade)

  projectId      String?                 @db.ObjectId
  conversionCode String?
  status         ProjectConversionStatus @default(PENDING)
  convertedAt    DateTime?
  metadata       Json?
  notes          String?

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([demandPlanId])
  @@index([status])
}
