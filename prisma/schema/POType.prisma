enum POTypeStatus {
  ACTIVE
  INACTIVE
}

model POType {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  code        String // e.g., "S", "P", "M"
  name        String // e.g., "Service", "Product", "Mixed"
  description String? // Detailed description of the PO type

  // Configuration
  isDefault             Boolean @default(false) // Default PO type for new POs
  requiresDelivery      Boolean @default(true) // Whether this type requires delivery tracking
  requiresInspection    Boolean @default(false) // Whether items require inspection on delivery
  allowsPartialDelivery Boolean @default(true) // Whether partial deliveries are allowed

  // Workflow settings
  autoCreateInvoice Boolean @default(false) // Auto-generate invoice when PO is received
  invoiceTrigger    String? // When to trigger invoice: "ON_APPROVAL", "ON_DELIVERY", "ON_COMPLETION"

  status    POTypeStatus @default(ACTIVE)
  isDeleted Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  // Relationships
  purchaseOrders PurchaseOrder[]

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@index([status])
}
