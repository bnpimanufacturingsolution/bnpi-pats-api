enum PaymentTermStatus {
  ACTIVE
  INACTIVE
}

model PaymentTerm {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  // Project/Estimation relationship (optional - for project-specific payment terms)
  projectId    String?     @db.ObjectId
  project      Project?    @relation(fields: [projectId], references: [id])
  estimationId String?     @db.ObjectId
  estimation   Estimation? @relation(fields: [estimationId], references: [id])

  code        String // e.g., "NET30", "COD", "CIA"
  name        String // e.g., "Net 30 Days", "Cash on Delivery"
  description String? // Detailed description of the payment term

  // Payment timing
  dueDays      Int    @default(0) // Number of days until payment is due (0 for immediate)
  discountDays Int? // Days within which early payment discount applies
  discountRate Float? // Early payment discount percentage (e.g., 2 for 2%)

  // Penalty settings
  lateFeeRate      Float? // Late fee percentage per period
  lateFeeType      String? // "PERCENTAGE" or "FIXED"
  lateFeeGraceDays Int? // Grace period before late fees apply

  // Default settings
  isDefault Boolean @default(false) // Whether this is the default payment term

  // Status
  status PaymentTermStatus @default(ACTIVE)

  // Additional settings
  requiresDeposit   Boolean @default(false)
  depositPercentage Float? // Required deposit percentage (e.g., 50 for 50%)
  notes             String?

  // Installment definitions for payment schedule generation
  installments PaymentTermInstallment[]

  // Relationships
  purchaseOrders PurchaseOrder[]

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([code, workspaceId])
  @@index([workspaceId])
  @@index([projectId])
  @@index([estimationId])
  @@index([status])
  @@index([isDefault])
}
