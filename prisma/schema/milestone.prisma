enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum MilestonePriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum MilestonePhase {
  FOUNDATION
  CORE_MODULES
  ADVANCED_FEATURES
  ENHANCED_FEATURES
  INTEGRATION_OPTIMIZATION
  ENTERPRISE_FEATURES
}

model Milestone {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  // Basic Information
  title       String
  description String?
  phase       MilestonePhase
  status      MilestoneStatus   @default(NOT_STARTED)
  priority    MilestonePriority @default(MEDIUM)

  // Progress Tracking (auto-calculated from items)
  progressPercent Int @default(0) // 0-100 percentage, updated when items change

  // Dates
  startDate     DateTime?
  targetDate    DateTime?
  completedDate DateTime?

  // Assignment
  assignedTo String[] @default([]) // User IDs

  // Project/Estimation relation (optional)
  projectId    String?     @db.ObjectId
  project      Project?    @relation(fields: [projectId], references: [id])
  estimationId String?     @db.ObjectId
  estimation   Estimation? @relation(fields: [estimationId], references: [id])

  // Items relation - track which items belong to this milestone
  items Item[]

  // Metadata
  tags         String[] @default([])
  dependencies String[] @default([]) // IDs of milestones this depends on
  blockers     String[] @default([]) // Issues blocking this milestone

  // Tracking
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([phase])
  @@index([status])
  @@index([priority])
  @@index([projectId])
  @@index([estimationId])
}
