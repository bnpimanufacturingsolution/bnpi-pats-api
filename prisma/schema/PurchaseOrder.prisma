enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  COMPLETED
  CANCELLED
}

// Composite type for purchase order line items (additional details beyond linked Items)
type PurchaseOrderItem {
  itemCode    String? // Item code / SKU (e.g., "LG 55UK762H")
  description String // Item description
  quantity    Int // Ordered quantity
  unit        String? // Unit of measure (e.g., "pcs", "unit/s", "kg")
  unitPrice   Float // Price per unit
  totalPrice  Float // quantity * unitPrice
  remarks     String? // Additional notes
}

model PurchaseOrder {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  workspaceId    String     @db.ObjectId
  workspace      Workspace? @relation(fields: [workspaceId], references: [id])
  organizationId String? // External organization ID from req

  poNumber String @unique // e.g., "PO-2025-001"

  // Vendor relationship (required)
  vendorId String @db.ObjectId
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  // Estimation relationship (optional)
  estimationId String?     @db.ObjectId
  estimation   Estimation? @relation(fields: [estimationId], references: [id])

  // Project relationship (optional)
  projectId String?  @db.ObjectId
  project   Project? @relation(fields: [projectId], references: [id])

  // PO Type relationship (optional)
  poTypeId String? @db.ObjectId
  poType   POType? @relation(fields: [poTypeId], references: [id])

  // Dates
  orderDate            DateTime  @default(now()) // Date PO was created
  expectedDeliveryDate DateTime? // Expected delivery date
  approvalDate         DateTime? // Date PO was approved

  // Approval workflow
  requestedBy           String? // Person who requested the PO
  requestedByTitle      String? // Requisitioner designation (e.g., "VP Sales")
  requestedByDepartment String? // Requisitioner department (e.g., "Sales")
  checkedBy             String? // Person who checked/processed the PO
  checkedByTitle        String? // Checker title (e.g., "PROCUREMENT MANAGER")
  approvedBy            String? // Person who approved the PO
  approvedByTitle       String? // Approver title (e.g., "CHIEF EXECUTIVE OFFICER")
  acknowledgedBy        String? // Person who acknowledged receipt of the PO

  // Line items
  items PurchaseOrderItem[]

  // Financial summary
  subtotal       Float  @default(0) // Sum of all item totals
  taxPercentage  Float? // Tax percentage (e.g., 12 for 12%)
  taxAmount      Float  @default(0) // Calculated tax amount
  discountAmount Float  @default(0) // Discount amount
  totalAmount    Float  @default(0) // Final total (subtotal + tax - discount)
  currency       String @default("PHP")

  // Terms and conditions
  paymentTermId   String?      @db.ObjectId
  paymentTerm     PaymentTerm? @relation(fields: [paymentTermId], references: [id])
  shippingTerms   String? // e.g., "FOB Destination"
  leadTime        String? // e.g., "ON-STOCK", "30 days"
  availability    String? // e.g., "ON STOCK", "Non-Stock"
  deliveryTerms   String? // e.g., "for delivery"
  deliveryAddress String? // Delivery location
  termsConditions String? // Additional terms and conditions

  // Status tracking
  status  PurchaseOrderStatus @default(DRAFT)
  remarks String?

  // Document attachments
  documentUrls String[] @default([])

  // Relationships
  sourceItems     Item[] // Items that this PO was created from
  deliveryOrders  DeliveryOrder[]
  invoices        Invoice[]
  transactions    Transaction[] // Transactions created from this PO
  paymentSchedule PaymentSchedule? // Payment schedule generated on approval

  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workspaceId])
  @@index([vendorId])
  @@index([estimationId])
  @@index([projectId])
  @@index([poTypeId])
  @@index([paymentTermId])
  @@index([status])
  @@index([orderDate])
}
