// =============================================================================
// Bandai PATS — Manufacturing Domain Schema (DRAFT, PostgreSQL)
// =============================================================================
//
// Status: PROPOSED (2026-07-07) — standalone draft, deliberately NOT part of the live
// `prisma/schema` build (which remains the MongoDB-backed legacy PMS domain). Nothing imports
// this yet; it exists so the API-side model is designed and validated against the frontend
// domain before any runtime wiring. Mirrors `bnpi-pats-app/app/types/pats/*` one-to-one:
//   WorkflowGroup / Stage / SubStage (generic admin-authored catalog)
//   Project / ProductSpecification / Pmrs / PartsList / RoutingStep / Part / Lot
//   Batch / BatchPartLine (execution containers)
//   StageEvent / InventoryTransaction / RoutingViolation / ProcessChangeLog (append ledger)
//   Station / WorkInstruction / UserPreference (2026-07-07 additions: stations, localization,
//   first-time walkthrough)
//
// Conventions:
// - Provider is PostgreSQL per the on-prem appliance alignment
//   (docs/architecture/2026-07-07-pats-onprem-api-architecture-readiness.md, Decision 5.1):
//   real versioned migrations (`prisma migrate`) over Mongo's `db push`.
// - A "stage step" (the frontend's StageStepRef) is a (stageId, subStageId?) column pair.
// - Localized text (frontend LocalizedText: { en, ja?, fil? }) is a Json column — en required
//   by application-level validation, ja/fil optional.
// - `workspaceId` scopes tenant-owned records to a Line (workspace), matching the existing
//   API's per-tenant WorkspaceRole pattern. No cross-schema FK — the workspace lives in the
//   legacy schema until this domain goes live.
// - Ledger tables (StageEvent, InventoryTransaction, RoutingViolation, ProcessChangeLog) are
//   append-oriented: no updatedAt, rows are never rewritten (violation resolution is the one
//   sanctioned mutation, kept as explicit resolution fields).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/pats-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PATS_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog (admin-authored, generic — no fixed stage enums anywhere)
// ---------------------------------------------------------------------------

enum LinkageMode {
  LINKED
  STANDALONE
}

enum ProductSourceStatus {
  SOURCE_ALIGNED     @map("source-aligned")
  NEEDS_CONFIRMATION @map("needs-confirmation")
  MANUAL
}

enum CatalogLifecycleStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CanonicalEvidenceStatus {
  CONFIRMED
  INFERRED
  PROVISIONAL
  SOURCE_ANOMALY
  UNAVAILABLE_DEPENDENCY
  NEEDS_CONFIRMATION
  CONFLICTING
  STALE
}

enum SourceEvidenceLocatorType {
  WORKBOOK_CELL
  WORKBOOK_RANGE
  PDF_PAGE
  PDF_TEXT
  OTHER
}

enum CanonicalEvidenceSubjectType {
  PRODUCT
  MODEL
  MODEL_PART
  BOM_DEFINITION
  BOM_LINE
  PROCESS_ROUTE
  ROUTE_STAGE
}

enum BomRelationshipKind {
  COMPONENT
  ASSEMBLY_COMPONENT
  DECORATION_INPUT
  PACKAGING_COMPONENT
  OTHER
}

model Product {
  id              String                  @id @default(uuid())
  productCode     String                  @unique
  productName     String
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  models          Model[]
  projects        Project[]
}

model Model {
  id              String                   @id @default(uuid())
  productId       String
  product         Product                  @relation(fields: [productId], references: [id])
  modelNumber     String
  modelName       String?
  sourceStatus    ProductSourceStatus
  sourceReference Json?
  skuCode         String?
  pinned          Boolean                  @default(false)
  lifecycleStatus CatalogLifecycleStatus   @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus  @default(NEEDS_CONFIRMATION)
  rowVersion      Int                      @default(1)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  modelParts      ModelPart[]
  bomDefinitions  BomDefinition[]
  processRoutes   ProcessRoute[]
  allocations     ProjectModelAllocation[]
  projectParts    Part[]                   @relation("ModelProjectParts")

  @@unique([productId, modelNumber])
  @@index([productId])
}

model ModelPart {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  partCode        String
  partName        String
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  // Ordered catalog-level StageStepRef[] template. Promotion into a versioned PartsList is
  // intentionally application-controlled until the template contract is confirmed.
  routingSteps    Json
  projectParts    Part[]                  @relation("ModelPartProjectParts")
  bomLines        BomLine[]

  @@unique([modelId, partCode])
  @@index([modelId])
}

// A versioned material relationship for one reusable catalog model. Quantity and UOM remain
// nullable because the analyzed client sources do not consistently provide a convertible basis.
model BomDefinition {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  revision        Int
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lines           BomLine[]

  @@unique([modelId, revision])
  @@index([modelId])
}

model BomLine {
  id                   String                  @id @default(uuid())
  bomDefinitionId      String
  bomDefinition        BomDefinition           @relation(fields: [bomDefinitionId], references: [id])
  modelPartId          String
  modelPart            ModelPart               @relation(fields: [modelPartId], references: [id])
  lineNumber           Int
  relationshipKind     BomRelationshipKind
  quantityMagnitude    Float?
  quantityUom          String?
  usageBasis           String?
  sourceRepresentation String?
  lifecycleStatus      CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus       CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([bomDefinitionId, lineNumber])
  @@index([bomDefinitionId])
  @@index([modelPartId])
}

// A versioned, model-applicable process definition. Stage ownership remains an explicit mapping
// seam because the existing Stage/SubStage tables are project-bound in this draft schema.
model ProcessRoute {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  revision        Int
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  stages          ProcessRouteStage[]

  @@unique([modelId, revision])
  @@index([modelId])
}

model ProcessRouteStage {
  id                   String                  @id @default(uuid())
  processRouteId       String
  processRoute         ProcessRoute            @relation(fields: [processRouteId], references: [id])
  sequence             Int
  stageKey             String?
  stageName            String?
  stageDefinitionId    String?
  subStageKey          String?
  subStageName         String?
  operationCode        String?
  operationName        String?
  sourceRepresentation String?
  lifecycleStatus      CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus       CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([processRouteId, sequence])
  @@index([processRouteId])
}

model WorkflowGroup {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id])
  name         String
  linkageMode  LinkageMode
  displayOrder Int
  isSystemSeed Boolean     @default(false)
  stages       Stage[]

  @@index([projectId])
}

model Stage {
  id              String                @id @default(uuid())
  workflowGroupId String
  workflowGroup   WorkflowGroup         @relation(fields: [workflowGroupId], references: [id])
  name            String
  // Optional per-locale name overrides: { ja?: string, fil?: string }
  nameLocalized   Json?
  displayOrder    Int
  isSystemSeed    Boolean               @default(false)
  subStageLinks   SubStageEligibility[]

  @@index([workflowGroupId])
}

model SubStage {
  id                            String                @id @default(uuid())
  name                          String
  nameLocalized                 Json?
  displayOrder                  Int
  isSystemSeed                  Boolean               @default(false)
  isConfigurable                Boolean               @default(true)
  isBuffer                      Boolean               @default(false)
  hasQualityCheckpoint          Boolean               @default(false)
  isMandatoryCheckpoint         Boolean               @default(false)
  alwaysAlertOnRoutingViolation Boolean               @default(true)
  subProcessGroup               String?
  isDisabled                    Boolean               @default(false)
  eligibleStages                SubStageEligibility[]
}

// A SubStage can be eligible under more than one Stage (the Capsulation/Assortment
// Assembly-vs-Warehouse mechanism) — a join table, not a single parent FK.
model SubStageEligibility {
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  subStageId String
  subStage   SubStage @relation(fields: [subStageId], references: [id])

  @@id([stageId, subStageId])
}

// ---------------------------------------------------------------------------
// Planning definition
// ---------------------------------------------------------------------------

model Project {
  id                         String                   @id @default(uuid())
  workspaceId                String
  projectCode                String                   @unique
  name                       String
  requiredProductionQuantity Int
  productId                  String?
  product                    Product?                 @relation(fields: [productId], references: [id])
  createdAt                  DateTime                 @default(now())
  productSpecification       ProductSpecification?
  pmrs                       Pmrs?
  modelAllocations           ProjectModelAllocation[]
  partsLists                 PartsList[]
  workflowGroups             WorkflowGroup[]
  parts                      Part[]
  lots                       Lot[]
  processChangeLogs          ProcessChangeLog[]

  @@index([workspaceId])
  @@index([productId])
}

model ProjectModelAllocation {
  id              String   @id @default(uuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id])
  modelId         String
  model           Model    @relation(fields: [modelId], references: [id])
  plannedQuantity Int
  createdAt       DateTime @default(now())
  batches         Batch[]

  @@unique([projectId, modelId])
  @@index([projectId])
  @@index([modelId])
}

model ProductSpecification {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  skuCode              String
  productName          String
  trayQuantityStandard Int
  createdAt            DateTime @default(now())
}

// Minimal placeholder — PMRS structure remains NEEDS_CONFIRMATION (BRD Open Question #2).
// Do not extend without stakeholder confirmation.
model Pmrs {
  id          String  @id @default(uuid())
  projectId   String  @unique
  project     Project @relation(fields: [projectId], references: [id])
  partsListId String?
}

model PartsList {
  id        String        @id @default(uuid())
  projectId String
  project   Project       @relation(fields: [projectId], references: [id])
  version   Int
  createdAt DateTime      @default(now())
  steps     RoutingStep[]

  @@unique([projectId, version])
}

// One ordered routing step for one Part inside one PartsList version — the frontend's
// PartsListEntry.routingSteps flattened into rows. Ordering is the point: an unordered set
// cannot express "Full Spray -> Mask Spray -> Tampo".
model RoutingStep {
  id          String    @id @default(uuid())
  partsListId String
  partsList   PartsList @relation(fields: [partsListId], references: [id])
  partId      String
  part        Part      @relation(fields: [partId], references: [id])
  stageId     String
  subStageId  String?
  stepOrder   Int

  @@unique([partsListId, partId, stepOrder])
  @@index([partId])
}

model Part {
  id                       String          @id @default(uuid())
  projectId                String
  project                  Project         @relation(fields: [projectId], references: [id])
  partCode                 String
  partName                 String
  sourceModelId            String?
  sourceModel              Model?          @relation("ModelProjectParts", fields: [sourceModelId], references: [id])
  sourceModelPartId        String?
  sourceModelPart          ModelPart?      @relation("ModelPartProjectParts", fields: [sourceModelPartId], references: [id])
  // Hybrid per-part variance tolerance — either, both, or neither bound may be set;
  // application falls back to the system default (5%) when both are null.
  variancePercentThreshold Float?
  varianceAbsoluteFloor    Int?
  routingSteps             RoutingStep[]
  lots                     Lot[]
  batchPartLines           BatchPartLine[]

  @@unique([projectId, partCode])
  @@index([sourceModelId])
  @@index([sourceModelPartId])
}

model Lot {
  id                         String   @id @default(uuid())
  projectId                  String
  project                    Project  @relation(fields: [projectId], references: [id])
  lotCode                    String   @unique
  lotName                    String
  partsListId                String
  partsListVersion           Int
  partId                     String
  part                       Part     @relation(fields: [partId], references: [id])
  partName                   String
  requiredProductionQuantity Int
  // Structured replacement for the PRD's free-text labelBreakdown (whiteboard stage-1 math:
  // requiredProductionQuantity / labelPackSize = countable labels, e.g. 100,000 / 200 = 500). Label counts
  // are derived by the application, never stored.
  labelPackSize              Int
  // Lot numbers are assigned once at Planning and never reassigned (client doc, stage 1).
  createdAtStage             String   @default("Planning")
  createdAt                  DateTime @default(now())
  batches                    Batch[]
}

// ---------------------------------------------------------------------------
// Execution containers
// ---------------------------------------------------------------------------

enum BatchStatus {
  PLANNED
  ACTIVE
  HELD
  CLOSED
  SCRAPPED
}

model Batch {
  id                       String                  @id @default(uuid())
  batchCode                String                  @unique
  barcodeValue             String                  @unique
  lotId                    String
  lot                      Lot                     @relation(fields: [lotId], references: [id])
  plannedQuantity          Int
  labelPackSize            Int
  projectModelAllocationId String?
  projectModelAllocation   ProjectModelAllocation? @relation(fields: [projectModelAllocationId], references: [id])
  currentStageId           String
  currentSubStageId        String?
  status                   BatchStatus             @default(PLANNED)
  createdAt                DateTime                @default(now())
  parts                    BatchPartLine[]

  @@index([lotId])
  @@index([projectModelAllocationId])
  @@index([currentStageId])
}

// Batch <-> Part cardinality is unconfirmed (domain foundation, Section 8) — modeled
// many-per-batch as the more general reading, same as the frontend.
model BatchPartLine {
  batchId  String
  batch    Batch  @relation(fields: [batchId], references: [id])
  partId   String
  part     Part   @relation(fields: [partId], references: [id])
  quantity Int

  @@id([batchId, partId])
}

// ---------------------------------------------------------------------------
// Execution ledger (append-oriented, auditable)
// ---------------------------------------------------------------------------

enum StageEventType {
  STAGE_SCAN_RECORDED
  ROUTE_VALIDATED
  ROUTING_VIOLATION_DETECTED
  STAGE_COMPLETED
  VARIANCE_FLAG_RAISED
}

model StageEvent {
  id                 String            @id @default(uuid())
  stageId            String
  subStageId         String?
  eventType          StageEventType
  batchId            String
  lotId              String
  partId             String?
  quantity           Int?
  occurredAt         DateTime
  actor              String
  isRoutingViolation Boolean           @default(false)
  routingViolation   RoutingViolation?

  @@index([batchId, occurredAt])
  @@index([stageId])
}

enum InventoryTransactionType {
  RECEIVING
  ISSUANCE
}

model InventoryTransaction {
  id                String                   @id @default(uuid())
  transactionType   InventoryTransactionType
  batchId           String
  partId            String
  lotId             String
  fromStageId       String?
  fromSubStageId    String?
  toStageId         String
  toSubStageId      String?
  expectedQuantity  Int
  actualQuantity    Int
  withdrawalFormRef String?
  recordedAt        DateTime
  recordedBy        String

  @@index([batchId, recordedAt])
  @@index([lotId])
}

model RoutingViolation {
  id                  String     @id @default(uuid())
  stageEventId        String     @unique
  stageEvent          StageEvent @relation(fields: [stageEventId], references: [id])
  batchId             String
  lotId               String
  partId              String
  attemptedStageId    String
  attemptedSubStageId String?
  // The allowed route at detection time, denormalized as [{stageId, subStageId, order}] so the
  // violation stays auditable even after the PartsList is versioned forward.
  expectedSteps       Json
  detectedAt          DateTime
  resolved            Boolean    @default(false)
  resolvedAt          DateTime?
  resolvedBy          String?
  resolutionNote      String?

  @@index([batchId])
  @@index([resolved])
}

model ProcessChangeLog {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  lotId              String
  batchId            String?
  partId             String
  previousStageId    String
  previousSubStageId String?
  newStageId         String
  newSubStageId      String?
  actor              String
  reason             String
  changedAt          DateTime

  @@index([projectId, changedAt])
}

// ---------------------------------------------------------------------------
// Stations, localization, walkthrough (2026-07-07 model additions)
// ---------------------------------------------------------------------------

enum ScreenType {
  COMPUTER
  TABLET
}

model Station {
  id              String        @id @default(uuid())
  workspaceId     String
  name            String
  stageId         String
  screenType      ScreenType    @default(COMPUTER)
  scannerAttached Boolean       @default(true)
  printerAttached Boolean       @default(true)
  displayOrder    Int
  isEnabled       Boolean       @default(true)
  boundSteps      StationStep[]

  @@index([workspaceId])
}

model StationStep {
  stationId  String
  station    Station @relation(fields: [stationId], references: [id])
  stageId    String
  subStageId String?
  // Composite id needs a non-null member for subStageId-null base steps.
  id         String  @id @default(uuid())

  @@unique([stationId, stageId, subStageId])
}

model WorkInstruction {
  id         String   @id @default(uuid())
  stageId    String
  subStageId String?
  // Ordered steps, each a LocalizedText: [{ en, ja?, fil? }, ...]
  steps      Json
  version    Int      @default(1)
  updatedAt  DateTime @updatedAt

  @@unique([stageId, subStageId, version])
}

enum Locale {
  EN
  JA
  FIL
}

// Gate 2 identity is deployment-scoped. It intentionally has no Workspace,
// membership-tenancy, or client-selected ProductionLine relation.
enum SubjectStatus {
  ACTIVE
  DISABLED
}

enum SubjectAssignmentKind {
  CAPABILITY
  ROLE_BUNDLE
}

enum SubjectAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Subject {
  id                  String              @id @default(uuid())
  provider            String
  issuer              String
  providerSubject     String
  displayNameSnapshot String?
  emailSnapshot       String?
  status              SubjectStatus       @default(ACTIVE)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  assignments         SubjectAssignment[]
  credential          SubjectCredential?

  @@unique([provider, issuer, providerSubject])
  @@index([status])
}

model SubjectCredential {
  id           String    @id @default(uuid())
  subjectId    String    @unique
  subject      Subject   @relation(fields: [subjectId], references: [id])
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([username])
}

model SubjectAssignment {
  id          String                  @id @default(uuid())
  subjectId   String
  subject     Subject                 @relation(fields: [subjectId], references: [id])
  kind        SubjectAssignmentKind
  key         String
  status      SubjectAssignmentStatus @default(ACTIVE)
  assignedAt  DateTime                @default(now())
  suspendedAt DateTime?
  revokedAt   DateTime?
  version     Int                     @default(1)
  updatedAt   DateTime                @updatedAt

  @@unique([subjectId, kind, key])
  @@index([subjectId, status])
  @@index([kind, key, status])
}

model UserPreference {
  userId         String   @id
  locale         Locale   @default(EN)
  // Completed walkthrough tour keys, e.g. ["dashboard", "station"].
  completedTours String[]
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Source-backed client intake (raw file bytes stay in Drive/object storage)
// ---------------------------------------------------------------------------

enum SourceRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SourceArtifactType {
  WORKBOOK
  PDF
  OTHER
}

enum SourceExtractionStatus {
  COMPLETED
  PARTIAL
  FAILED
}

model SourceRun {
  id          String           @id @default(uuid())
  workspaceId String
  sourceLabel String
  status      SourceRunStatus  @default(RUNNING)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  artifacts   SourceArtifact[]

  @@index([workspaceId, startedAt])
}

model SourceArtifact {
  id               String                 @id @default(uuid())
  sourceRunId      String
  sourceRun        SourceRun              @relation(fields: [sourceRunId], references: [id])
  fileName         String
  artifactType     SourceArtifactType
  mimeType         String
  sizeBytes        Int
  sha256           String
  productCode      String?
  extractionStatus SourceExtractionStatus
  analysis         Json
  reportMarkdown   String
  createdAt        DateTime               @default(now())
  issues           SourceIssue[]
  evidence         SourceEvidence[]

  @@unique([sourceRunId, fileName])
  @@index([sourceRunId])
  @@index([sha256])
}

model SourceIssue {
  id               String           @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact   @relation(fields: [sourceArtifactId], references: [id])
  code             String
  status           String
  severity         String
  message          String
  sheet            String?
  address          String?
  value            Json?
  canonicalValue   Json?
  createdAt        DateTime         @default(now())
  evidence         SourceEvidence[]

  @@index([sourceArtifactId])
  @@index([code, status])
}

// Immutable source coordinates and values used by canonical catalog records. Raw bytes remain in
// Drive/object storage; this table stores only traceable extracted evidence.
model SourceEvidence {
  id               String                    @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact            @relation(fields: [sourceArtifactId], references: [id])
  sourceIssueId    String?
  sourceIssue      SourceIssue?              @relation(fields: [sourceIssueId], references: [id])
  locatorType      SourceEvidenceLocatorType
  sheet            String?
  address          String?
  page             Int?
  rawValue         Json?
  formulaText      String?
  cachedValue      Json?
  normalizedValue  Json?
  quantityBasis    String?
  dependencyState  String?
  evidenceStatus   CanonicalEvidenceStatus
  createdAt        DateTime                  @default(now())
  canonicalLinks   CanonicalEvidenceLink[]
  crosswalks       CanonicalCrosswalk[]

  @@index([sourceArtifactId])
  @@index([sourceIssueId])
  @@index([evidenceStatus])
}

// The subject type is bounded and validated by the catalog application service. This link spans
// the already-existing catalog tables and keeps source evidence reusable without storing arbitrary
// workbook-shaped JSON on Product, Model, or ModelPart.
model CanonicalEvidenceLink {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  relation         String
  createdAt        DateTime                     @default(now())

  @@unique([sourceEvidenceId, subjectType, subjectId, relation])
  @@index([subjectType, subjectId])
}

model CanonicalCrosswalk {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  rawValue         String
  canonicalValue   String
  ruleCode         String
  confidence       Float?
  rationale        String?
  status           CanonicalEvidenceStatus
  createdAt        DateTime                     @default(now())

  @@index([subjectType, subjectId])
  @@index([rawValue])
}

// Durable retry record for canonical draft writes. A row is claimed before the business
// transaction and completed only after the response is known; concurrent reuse is rejected.
model CatalogIdempotencyRecord {
  id              String    @id @default(uuid())
  actorId         String
  operation       String
  idempotencyKey  String
  requestHash     String
  status          Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@unique([actorId, operation, idempotencyKey])
  @@index([createdAt])
}
