// =============================================================================
// Bandai PATS — Manufacturing Domain Schema (DRAFT, PostgreSQL)
// =============================================================================
//
// Status: PROPOSED (2026-07-07) — standalone draft, deliberately NOT part of the live
// `prisma/schema` build (which remains the MongoDB-backed legacy PMS domain). Nothing imports
// this yet; it exists so the API-side model is designed and validated against the frontend
// domain before any runtime wiring. Mirrors `bnpi-pats-app/app/types/pats/*` one-to-one:
//   WorkflowGroup / Stage / SubStage (generic admin-authored catalog)
//   Project / ProductSpecification / Pmrs / PartsList / RoutingStep / Part / Lot
//   Batch / BatchPartLine (execution containers)
//   StageEvent / InventoryTransaction / RoutingViolation / ProcessChangeLog (append ledger)
//   Station / WorkInstruction / UserPreference (2026-07-07 additions: stations, localization,
//   first-time walkthrough)
//
// Conventions:
// - Provider is PostgreSQL per the on-prem appliance alignment
//   (docs/architecture/2026-07-07-pats-onprem-api-architecture-readiness.md, Decision 5.1):
//   real versioned migrations (`prisma migrate`) over Mongo's `db push`.
// - A "stage step" (the frontend's StageStepRef) is a (stageId, subStageId?) column pair.
// - Localized text (frontend LocalizedText: { en, ja?, fil? }) is a Json column — en required
//   by application-level validation, ja/fil optional.
// - `workspaceId` scopes tenant-owned records to a Line (workspace), matching the existing
//   API's per-tenant WorkspaceRole pattern. No cross-schema FK — the workspace lives in the
//   legacy schema until this domain goes live.
// - Ledger tables (StageEvent, InventoryTransaction, RoutingViolation, ProcessChangeLog) are
//   append-oriented: no updatedAt, rows are never rewritten (violation resolution is the one
//   sanctioned mutation, kept as explicit resolution fields).
// =============================================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/pats-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PATS_DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Catalog (admin-authored, generic — no fixed stage enums anywhere)
// ---------------------------------------------------------------------------

enum LinkageMode {
  LINKED
  STANDALONE
}

enum ProductSourceStatus {
  SOURCE_ALIGNED     @map("source-aligned")
  NEEDS_CONFIRMATION @map("needs-confirmation")
  MANUAL
}

enum CatalogLifecycleStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

// Canonical planning and execution lifecycle vocabularies. The older draft models remain
// physical compatibility tables while the API exposes the canonical resource names.
enum PlanLifecycleStatus {
  DRAFT
  READY
  RELEASED
  PAUSED
  COMPLETED
  CANCELLED
}

enum AllocationLifecycleStatus {
  DRAFT
  COMMITTED
  SUPERSEDED
}

enum RouteVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum LotStatus {
  PLANNED
  ACTIVE
  HELD
  COMPLETED
  CANCELLED
}

enum LotPartAllocationStatus {
  PLANNED
  COMMITTED
  CLOSED
}

enum MaterialRequirementStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_ISSUED
  FULFILLED
  CANCELLED
}

enum StageEventStatus {
  RECORDED
  ACCEPTED
  BLOCKED
  CORRECTED
}

enum InventoryTransactionStatus {
  RECORDED
  ACCEPTED
  CORRECTED
}

enum RoutingViolationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED
}

enum QualityInspectionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QualityDecisionType {
  PASSED
  FAILED
  HOLD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum OutboxMessageStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

enum IdempotencyRecordStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum CanonicalEvidenceStatus {
  CONFIRMED
  INFERRED
  PROVISIONAL
  SOURCE_ANOMALY
  UNAVAILABLE_DEPENDENCY
  NEEDS_CONFIRMATION
  CONFLICTING
  STALE
}

enum SourceEvidenceLocatorType {
  WORKBOOK_CELL
  WORKBOOK_RANGE
  PDF_PAGE
  PDF_TEXT
  OTHER
}

enum CanonicalEvidenceSubjectType {
  PRODUCT
  MODEL
  MODEL_PART
  BOM_DEFINITION
  BOM_LINE
  PROCESS_ROUTE
  ROUTE_STAGE
}

enum BomRelationshipKind {
  COMPONENT
  ASSEMBLY_COMPONENT
  DECORATION_INPUT
  PACKAGING_COMPONENT
  OTHER
}

model Product {
  id              String                  @id @default(uuid())
  productCode     String                  @unique
  productName     String
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  models          Model[]
  projects        Project[]
}

model Model {
  id                String                   @id @default(uuid())
  productId         String
  product           Product                  @relation(fields: [productId], references: [id])
  modelNumber       String
  modelName         String?
  sourceStatus      ProductSourceStatus
  sourceReference   Json?
  skuCode           String?
  pinned            Boolean                  @default(false)
  lifecycleStatus   CatalogLifecycleStatus   @default(DRAFT)
  evidenceStatus    CanonicalEvidenceStatus  @default(NEEDS_CONFIRMATION)
  rowVersion        Int                      @default(1)
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  modelParts        ModelPart[]
  bomDefinitions    BomDefinition[]
  processRoutes     ProcessRoute[]
  allocations       ProjectModelAllocation[]
  demandAllocations PlanDemandAllocation[]
  projectParts      Part[]                   @relation("ModelProjectParts")

  @@unique([productId, modelNumber])
  @@index([productId])
}

model ModelPart {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  partCode        String
  partName        String
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  // Ordered catalog-level StageStepRef[] template. Promotion into a versioned PartsList is
  // intentionally application-controlled until the template contract is confirmed.
  routingSteps    Json
  projectParts    Part[]                  @relation("ModelPartProjectParts")
  bomLines        BomLine[]

  @@unique([modelId, partCode])
  @@index([modelId])
}

// A versioned material relationship for one reusable catalog model. Quantity and UOM remain
// nullable because the analyzed client sources do not consistently provide a convertible basis.
model BomDefinition {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  revision        Int
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  lines           BomLine[]

  @@unique([modelId, revision])
  @@index([modelId])
}

model BomLine {
  id                   String                  @id @default(uuid())
  bomDefinitionId      String
  bomDefinition        BomDefinition           @relation(fields: [bomDefinitionId], references: [id])
  modelPartId          String
  modelPart            ModelPart               @relation(fields: [modelPartId], references: [id])
  lineNumber           Int
  relationshipKind     BomRelationshipKind
  quantityMagnitude    Float?
  quantityUom          String?
  usageBasis           String?
  sourceRepresentation String?
  lifecycleStatus      CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus       CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([bomDefinitionId, lineNumber])
  @@index([bomDefinitionId])
  @@index([modelPartId])
}

// A versioned, model-applicable process definition. Stage ownership remains an explicit mapping
// seam because the existing Stage/SubStage tables are project-bound in this draft schema.
model ProcessRoute {
  id              String                  @id @default(uuid())
  modelId         String
  model           Model                   @relation(fields: [modelId], references: [id])
  revision        Int
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  stages          ProcessRouteStage[]

  @@unique([modelId, revision])
  @@index([modelId])
}

model ProcessRouteStage {
  id                   String                  @id @default(uuid())
  processRouteId       String
  processRoute         ProcessRoute            @relation(fields: [processRouteId], references: [id])
  sequence             Int
  stageId              String?
  stage                Stage?                  @relation("ProcessRouteStageStage", fields: [stageId], references: [id])
  subStageId           String?
  subStage             SubStage?               @relation("ProcessRouteStageSubStage", fields: [subStageId], references: [id])
  stageKey             String?
  stageName            String?
  stageDefinitionId    String?
  subStageKey          String?
  subStageName         String?
  operationCode        String?
  operationName        String?
  sourceRepresentation String?
  lifecycleStatus      CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus       CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([processRouteId, sequence])
  @@index([processRouteId])
}

model WorkflowGroup {
  id              String                 @id @default(uuid())
  // Compatibility-only link from the original draft. New configuration is deployment-owned and
  // does not require a planning record.
  projectId       String?
  project         Project?               @relation(fields: [projectId], references: [id])
  name            String
  linkageMode     LinkageMode
  displayOrder    Int
  isSystemSeed    Boolean                @default(false)
  lifecycleStatus CatalogLifecycleStatus @default(DRAFT)
  stages          Stage[]

  @@index([projectId])
}

model Stage {
  id                 String                @id @default(uuid())
  workflowGroupId    String
  workflowGroup      WorkflowGroup         @relation(fields: [workflowGroupId], references: [id])
  name               String
  // Optional per-locale name overrides: { ja?: string, fil?: string }
  nameLocalized      Json?
  displayOrder       Int
  isSystemSeed       Boolean               @default(false)
  subStageLinks             SubStageEligibility[]
  stationSteps              StationStep[]
  processRouteStages        ProcessRouteStage[]   @relation("ProcessRouteStageStage")
  qualityStageAssignments   QualityStageAssignment[]

  @@index([workflowGroupId])
}

model SubStage {
  id                            String                @id @default(uuid())
  name                          String
  nameLocalized                 Json?
  displayOrder                  Int
  isSystemSeed                  Boolean               @default(false)
  isConfigurable                Boolean               @default(true)
  isBuffer                      Boolean               @default(false)
  hasQualityCheckpoint          Boolean               @default(false)
  isMandatoryCheckpoint         Boolean               @default(false)
  alwaysAlertOnRoutingViolation Boolean               @default(true)
  subProcessGroup               String?
  isDisabled                    Boolean               @default(false)
  eligibleStages                SubStageEligibility[]
  stationSteps                  StationStep[]
  processRouteStages            ProcessRouteStage[]   @relation("ProcessRouteStageSubStage")
  workProcesses                 WorkProcess[]
}

// A SubStage can be eligible under more than one Stage (the Capsulation/Assortment
// Assembly-vs-Warehouse mechanism) — a join table, not a single parent FK.
model SubStageEligibility {
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  subStageId String
  subStage   SubStage @relation(fields: [subStageId], references: [id])

  @@id([stageId, subStageId])
}

// ---------------------------------------------------------------------------
// Planning definition
// ---------------------------------------------------------------------------

model Project {
  id                         String                   @id @default(uuid())
  workspaceId                String
  projectCode                String                   @unique
  name                       String
  requiredProductionQuantity Int
  status                     PlanLifecycleStatus      @default(DRAFT)
  rowVersion                 Int                      @default(1)
  releasedAt                 DateTime?
  releasedBySubjectId        String?
  releasedBySubject          Subject?                 @relation("PlanReleaseActor", fields: [releasedBySubjectId], references: [id])
  productId                  String?
  product                    Product?                 @relation(fields: [productId], references: [id])
  createdAt                  DateTime                 @default(now())
  productSpecification       ProductSpecification?
  pmrs                       Pmrs?
  modelAllocations           ProjectModelAllocation[]
  demandAllocations          PlanDemandAllocation[]
  materialRequirements       MaterialRequirement[]
  partsLists                 PartsList[]
  workflowGroups             WorkflowGroup[]
  parts                      Part[]
  lots                       Lot[]
  processChangeLogs          ProcessChangeLog[]

  @@index([workspaceId])
  @@index([productId])
}

model ProjectModelAllocation {
  id                String                    @id @default(uuid())
  projectId         String
  project           Project                   @relation(fields: [projectId], references: [id])
  modelId           String
  model             Model                     @relation(fields: [modelId], references: [id])
  plannedQuantity   Int
  quantityMagnitude Decimal?                  @db.Decimal(18, 6)
  quantityUom       String?
  usageBasis        String?
  marketRegion      String?
  demandPurpose     String?
  sourceRevisionRef String?
  lifecycleStatus   AllocationLifecycleStatus @default(DRAFT)
  rowVersion        Int                       @default(1)
  createdAt         DateTime                  @default(now())
  batches           Batch[]

  @@unique([projectId, modelId])
  @@index([projectId])
  @@index([modelId])
}

model ProductSpecification {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  skuCode              String
  productName          String
  trayQuantityStandard Int
  sourceRevisionRef    String?
  rowVersion           Int      @default(1)
  createdAt            DateTime @default(now())
}

// Minimal placeholder — PMRS structure remains NEEDS_CONFIRMATION (BRD Open Question #2).
// Do not extend without stakeholder confirmation.
model Pmrs {
  id                    String  @id @default(uuid())
  projectId             String  @unique
  project               Project @relation(fields: [projectId], references: [id])
  partsListId           String?
  externalControlNumber String?
  revisionLabel         String?
  status                String  @default("attached")
  sourceReference       Json?
}

model PartsList {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id])
  version           Int
  status            RouteVersionStatus @default(DRAFT)
  sourceRevisionRef String?
  publishedAt       DateTime?
  rowVersion        Int                @default(1)
  createdAt         DateTime           @default(now())
  steps             RoutingStep[]

  @@unique([projectId, version])
}

// One ordered routing step for one Part inside one PartsList version — the frontend's
// PartsListEntry.routingSteps flattened into rows. Ordering is the point: an unordered set
// cannot express "Full Spray -> Mask Spray -> Tampo".
model RoutingStep {
  id          String       @id @default(uuid())
  partsListId String
  partsList   PartsList    @relation(fields: [partsListId], references: [id])
  partId      String
  part        Part         @relation(fields: [partId], references: [id])
  stageId     String
  subStageId  String?
  stepOrder   Int
  stageEvents StageEvent[]

  @@unique([partsListId, partId, stepOrder])
  @@index([partId])
}

model Part {
  id                       String                 @id @default(uuid())
  projectId                String
  project                  Project                @relation(fields: [projectId], references: [id])
  partCode                 String
  partName                 String
  sourceModelId            String?
  sourceModel              Model?                 @relation("ModelProjectParts", fields: [sourceModelId], references: [id])
  sourceModelPartId        String?
  sourceModelPart          ModelPart?             @relation("ModelPartProjectParts", fields: [sourceModelPartId], references: [id])
  // Hybrid per-part variance tolerance — either, both, or neither bound may be set;
  // application falls back to the system default (5%) when both are null.
  variancePercentThreshold Float?
  varianceAbsoluteFloor    Int?
  lifecycleStatus          CatalogLifecycleStatus @default(DRAFT)
  rowVersion               Int                    @default(1)
  routingSteps             RoutingStep[]
  lots                     Lot[]
  batchPartLines           BatchPartLine[]
  lotPartAllocations       LotPartAllocation[]
  inventoryTransactions    InventoryTransaction[]
  materialRequirements     MaterialRequirement[]

  @@unique([projectId, partCode])
  @@index([sourceModelId])
  @@index([sourceModelPartId])
}

model Lot {
  id                         String              @id @default(uuid())
  projectId                  String
  project                    Project             @relation(fields: [projectId], references: [id])
  lotCode                    String              @unique
  lotName                    String
  partsListId                String
  partsListVersion           Int
  partId                     String
  part                       Part                @relation(fields: [partId], references: [id])
  partName                   String
  requiredProductionQuantity Int
  status                     LotStatus           @default(PLANNED)
  quantityMagnitude          Decimal?            @db.Decimal(18, 6)
  quantityUom                String?
  usageBasis                 String?
  // Structured replacement for the PRD's free-text labelBreakdown (whiteboard stage-1 math:
  // requiredProductionQuantity / labelPackSize = countable labels, e.g. 100,000 / 200 = 500). Label counts
  // are derived by the application, never stored.
  labelPackSize              Int
  // Lot numbers are assigned once at Planning and never reassigned (client doc, stage 1).
  createdAtStage             String              @default("Planning")
  createdAt                  DateTime            @default(now())
  batches                    Batch[]
  partAllocations            LotPartAllocation[]
}

// ---------------------------------------------------------------------------
// Execution containers
// ---------------------------------------------------------------------------

enum BatchStatus {
  PLANNED
  ACTIVE
  HELD
  CLOSED
  SCRAPPED
}

model Batch {
  id                       String                   @id @default(uuid())
  batchCode                String                   @unique
  barcodeValue             String                   @unique
  lotId                    String
  lot                      Lot                      @relation(fields: [lotId], references: [id])
  plannedQuantity          Int
  labelPackSize            Int
  projectModelAllocationId String?
  projectModelAllocation   ProjectModelAllocation?  @relation(fields: [projectModelAllocationId], references: [id])
  currentStageId           String
  currentSubStageId        String?
  status                   BatchStatus              @default(PLANNED)
  rowVersion               Int                      @default(1)
  createdBySubjectId       String?
  createdBySubject         Subject?                 @relation("BatchCreator", fields: [createdBySubjectId], references: [id])
  createdAt                DateTime                 @default(now())
  parts                    BatchPartLine[]
  positionProjection       BatchPositionProjection?
  qualityInspections       QualityInspection[]

  @@index([lotId])
  @@index([projectModelAllocationId])
  @@index([currentStageId])
}

// Batch <-> Part cardinality is unconfirmed (domain foundation, Section 8) — modeled
// many-per-batch as the more general reading, same as the frontend.
model BatchPartLine {
  batchId             String
  batch               Batch              @relation(fields: [batchId], references: [id])
  partId              String
  part                Part               @relation(fields: [partId], references: [id])
  quantity            Int
  lotPartAllocationId String?
  lotPartAllocation   LotPartAllocation? @relation(fields: [lotPartAllocationId], references: [id])
  quantityMagnitude   Decimal?           @db.Decimal(18, 6)
  quantityUom         String?

  @@id([batchId, partId])
}

// ---------------------------------------------------------------------------
// Execution ledger (append-oriented, auditable)
// ---------------------------------------------------------------------------

enum StageEventType {
  STAGE_SCAN_RECORDED
  ROUTE_VALIDATED
  ROUTING_VIOLATION_DETECTED
  STAGE_COMPLETED
  VARIANCE_FLAG_RAISED
}

model StageEvent {
  id                   String            @id @default(uuid())
  stageId              String
  subStageId           String?
  eventType            StageEventType
  batchId              String
  lotId                String
  partId               String?
  quantity             Int?
  occurredAt           DateTime
  actor                String
  isRoutingViolation   Boolean           @default(false)
  status               StageEventStatus  @default(RECORDED)
  routeStepId          String?
  routeStep            RoutingStep?      @relation(fields: [routeStepId], references: [id])
  actorSubjectId       String?
  actorSubject         Subject?          @relation("StageEventActor", fields: [actorSubjectId], references: [id])
  quantityMagnitude    Decimal?          @db.Decimal(18, 6)
  quantityUom          String?
  usageBasis           String?
  sourceRepresentation String?
  routingViolation     RoutingViolation?

  @@index([batchId, occurredAt])
  @@index([stageId])
}

enum InventoryTransactionType {
  RECEIVING
  ISSUANCE
}

model InventoryTransaction {
  id                        String                     @id @default(uuid())
  transactionType           InventoryTransactionType
  batchId                   String
  part                      Part                       @relation(fields: [partId], references: [id])
  partId                    String
  lotId                     String
  fromStageId               String?
  fromSubStageId            String?
  toStageId                 String
  toSubStageId              String?
  expectedQuantity          Int
  actualQuantity            Int
  withdrawalFormRef         String?
  recordedAt                DateTime
  recordedBy                String
  status                    InventoryTransactionStatus @default(RECORDED)
  expectedQuantityMagnitude Decimal?                   @db.Decimal(18, 6)
  actualQuantityMagnitude   Decimal?                   @db.Decimal(18, 6)
  quantityUom               String?
  usageBasis                String?
  sourceRepresentation      String?
  recordedBySubjectId       String?
  recordedBySubject         Subject?                   @relation("InventoryTransactionRecorder", fields: [recordedBySubjectId], references: [id])
  materialRequirementId     String?
  materialRequirement       MaterialRequirement?       @relation(fields: [materialRequirementId], references: [id])

  @@index([batchId, recordedAt])
  @@index([lotId])
}

model RoutingViolation {
  id                  String                 @id @default(uuid())
  stageEventId        String                 @unique
  stageEvent          StageEvent             @relation(fields: [stageEventId], references: [id])
  batchId             String
  lotId               String
  partId              String
  attemptedStageId    String
  attemptedSubStageId String?
  // The allowed route at detection time, denormalized as [{stageId, subStageId, order}] so the
  // violation stays auditable even after the PartsList is versioned forward.
  expectedSteps       Json
  detectedAt          DateTime
  resolved            Boolean                @default(false)
  status              RoutingViolationStatus @default(OPEN)
  resolvedAt          DateTime?
  resolvedBy          String?
  resolvedBySubjectId String?
  resolvedBySubject   Subject?               @relation("RoutingViolationResolver", fields: [resolvedBySubjectId], references: [id])
  resolutionNote      String?

  @@index([batchId])
  @@index([resolved])
}

model ProcessChangeLog {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  lotId              String
  batchId            String?
  partId             String
  previousStageId    String
  previousSubStageId String?
  newStageId         String
  newSubStageId      String?
  actor              String
  actorSubjectId     String?
  actorSubject       Subject? @relation("ProcessChangeActor", fields: [actorSubjectId], references: [id])
  reason             String
  changedAt          DateTime

  @@index([projectId, changedAt])
}

// ---------------------------------------------------------------------------
// Stations, localization, walkthrough (2026-07-07 model additions)
// ---------------------------------------------------------------------------

enum ScreenType {
  COMPUTER
  TABLET
}

model Station {
  id                    String        @id @default(uuid())
  workspaceId           String
  name                  String
  // Nullable during the compatibility bridge; all new API-created stations require a code.
  stationCode           String?       @unique
  operationalContextKey String        @default("PATS")
  stageId               String
  screenType            ScreenType    @default(COMPUTER)
  scannerAttached       Boolean       @default(true)
  printerAttached       Boolean       @default(true)
  displayOrder          Int
  isEnabled             Boolean       @default(true)
  printerConnection     String?
  printerAddress        String?
  printerLanguage       String?
  printerDpi            Int?
  printerModel          String?
  labelWidthMm          Int?
  labelHeightMm         Int?
  printerAgent          String?
  boundSteps            StationStep[]
  booths                Booth[]
  printJobs             PrintJob[]

  @@index([workspaceId])
}

enum PrintJobStatus {
  QUEUED
  SENT
  FAILED
  SIMULATED
}

model PrintJob {
  id               String         @id @default(uuid())
  batchId          String
  stationId        String
  station          Station        @relation(fields: [stationId], references: [id])
  fromStageId      String
  fromSubStageId   String?
  toStageId        String?
  toSubStageId     String?
  barcodeValue     String
  quantity         Int
  sequence         Int
  reprintOf        String?
  language         String
  renderedPayload  String
  status           PrintJobStatus @default(QUEUED)
  failureReason    String?
  actor            String
  actorSubjectId   String?
  occurredAt       DateTime       @default(now())

  @@index([batchId, occurredAt])
  @@index([stationId, occurredAt])
}

/// Catalog work process under a SubStage (routing/CT/filter grain). Not a device mount.
model WorkProcess {
  id             String   @id @default(uuid())
  subStageId     String
  subStage       SubStage @relation(fields: [subStageId], references: [id])
  name           String
  displayOrder   Int
  isEnabled      Boolean  @default(true)
  isSystemSeed   Boolean  @default(false)
  labelledCycleTimeSec Int?
  booths         Booth[]
  dailySheets    MonitoringDailySheet[]
  stationBoards  MonitoringStationBoard[]

  @@index([subStageId])
  @@index([name])
}

/// Physical floor capacity cell. Many booths may share one Station PC (1:N).
model Booth {
  id             String       @id @default(uuid())
  workspaceId    String
  boothCode      String
  label          String?
  stationId      String?
  station        Station?     @relation(fields: [stationId], references: [id])
  stageId        String
  subStageId     String?
  workProcessId  String?
  workProcess    WorkProcess? @relation(fields: [workProcessId], references: [id])
  displayOrder   Int
  isEnabled      Boolean      @default(true)
  stationBoards  MonitoringStationBoard[]

  @@unique([workspaceId, boothCode])
  @@index([stationId])
  @@index([stageId, subStageId])
}

/// Line Leader day encode (durable). payload mirrors app DailyMonitoringSheet fields.
model MonitoringDailySheet {
  id              String       @id @default(uuid())
  workspaceId     String
  productionDate  String
  lineLabel       String
  workProcessId   String?
  workProcess     WorkProcess? @relation(fields: [workProcessId], references: [id])
  processName     String
  lineLeaderName  String       @default("")
  productName     String       @default("")
  modelName       String       @default("")
  partName        String       @default("")
  lotCode         String       @default("")
  targetPerShift  Int          @default(0)
  hourlyTarget    Int          @default(0)
  operatorNames   String       @default("")
  inputPartsAvailable Int?
  defectiveQty    Int?
  status          String       @default("draft")
  slotsJson       Json
  payloadJson     Json
  rowVersion      Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([workspaceId, productionDate])
  @@index([workProcessId])
}

/// Process Station Board encode (booth-level). payload mirrors app StationBoardEntry.
model MonitoringStationBoard {
  id             String       @id @default(uuid())
  workspaceId    String
  productionDate String
  boothId        String?
  booth          Booth?       @relation(fields: [boothId], references: [id])
  workProcessId  String?
  workProcess    WorkProcess? @relation(fields: [workProcessId], references: [id])
  boothLabel     String       @default("")
  processName    String       @default("")
  partName       String       @default("")
  lotCode        String       @default("")
  labelledCycleTimeSec Int    @default(0)
  targetPerHour  Int          @default(0)
  targetPerDay   Int          @default(0)
  slotsJson      Json
  payloadJson    Json
  rowVersion     Int          @default(1)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([workspaceId, productionDate])
  @@index([boothId])
}

model StationStep {
  stationId  String
  station    Station   @relation(fields: [stationId], references: [id])
  stageId    String
  stage      Stage     @relation(fields: [stageId], references: [id])
  subStageId String?
  subStage   SubStage? @relation(fields: [subStageId], references: [id])
  // Composite id needs a non-null member for subStageId-null base steps.
  id         String    @id @default(uuid())

  @@unique([stationId, stageId, subStageId])
}

model WorkInstruction {
  id                String             @id @default(uuid())
  stageId           String
  subStageId        String?
  // Ordered steps, each a LocalizedText: [{ en, ja?, fil? }, ...]
  steps             Json
  version           Int                @default(1)
  status            RouteVersionStatus @default(DRAFT)
  sourceRevisionRef String?
  updatedAt         DateTime           @updatedAt

  @@unique([stageId, subStageId, version])
}

// ---------------------------------------------------------------------------
// Canonical planning, projections, quality, and platform records
// ---------------------------------------------------------------------------

model PlanDemandAllocation {
  id                String                    @id @default(uuid())
  projectId         String
  project           Project                   @relation(fields: [projectId], references: [id])
  modelId           String
  model             Model                     @relation(fields: [modelId], references: [id])
  marketRegion      String
  demandPurpose     String
  quantityMagnitude Decimal                   @db.Decimal(18, 6)
  quantityUom       String
  usageBasis        String?
  sourceRevisionRef String?
  lifecycleStatus   AllocationLifecycleStatus @default(DRAFT)
  rowVersion        Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([projectId, lifecycleStatus])
  @@index([modelId, marketRegion, demandPurpose])
}

model MaterialRequirement {
  id                String                    @id @default(uuid())
  projectId         String
  project           Project                   @relation(fields: [projectId], references: [id])
  partId            String?
  part              Part?                     @relation(fields: [partId], references: [id])
  externalReference String?
  quantityMagnitude Decimal                   @db.Decimal(18, 6)
  quantityUom       String
  usageBasis        String?
  sourceRevisionRef String?
  status            MaterialRequirementStatus @default(DRAFT)
  rowVersion        Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  transactions      InventoryTransaction[]

  @@index([projectId, status])
  @@index([partId])
}

model LotPartAllocation {
  id                String                  @id @default(uuid())
  lotId             String
  lot               Lot                     @relation(fields: [lotId], references: [id])
  partId            String
  part              Part                    @relation(fields: [partId], references: [id])
  quantityMagnitude Decimal                 @db.Decimal(18, 6)
  quantityUom       String
  usageBasis        String?
  status            LotPartAllocationStatus @default(PLANNED)
  rowVersion        Int                     @default(1)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  batchPartLines    BatchPartLine[]

  @@unique([lotId, partId])
  @@index([partId])
}

model BatchPositionProjection {
  batchId           String           @id
  batch             Batch            @relation(fields: [batchId], references: [id])
  stageId           String
  subStageId        String?
  routeStepId       String?
  lastEventId       String?          @unique
  positionStatus    StageEventStatus @default(ACCEPTED)
  quantityMagnitude Decimal?         @db.Decimal(18, 6)
  quantityUom       String?
  projectionVersion Int              @default(1)
  updatedAt         DateTime         @updatedAt

  @@index([stageId, subStageId])
}

model QualityInspection {
  id                   String                  @id @default(uuid())
  batchId              String
  batch                Batch                   @relation(fields: [batchId], references: [id])
  stageId              String
  subStageId           String?
  stationId            String?
  inspectedQuantity    Decimal?                @db.Decimal(18, 6)
  quantityUom          String?
  status               QualityInspectionStatus @default(OPEN)
  inspectedBySubjectId String?
  inspectedBySubject   Subject?                @relation("QualityInspectionInspector", fields: [inspectedBySubjectId], references: [id])
  evidence             Json?
  startedAt            DateTime                @default(now())
  completedAt          DateTime?
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  decisions            QualityDecision[]

  @@index([batchId, createdAt])
  @@index([status, createdAt])
}

model QualityDecision {
  id                 String              @id @default(uuid())
  inspectionId       String
  inspection         QualityInspection   @relation(fields: [inspectionId], references: [id])
  decision           QualityDecisionType
  reasonCode         String?
  reasonNote         String?
  decidedBySubjectId String?
  decidedBySubject   Subject?            @relation("QualityDecisionActor", fields: [decidedBySubjectId], references: [id])
  decidedAt          DateTime            @default(now())

  @@index([inspectionId, decidedAt])
}

enum QualityStageAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Journey D stage allow-list (v1 stage grain only). Not a SubjectAssignment.key.
/// Fail closed: quality.resolve with zero ACTIVE rows cannot create/decide.
model QualityStageAssignment {
  id          String                       @id @default(uuid())
  subjectId   String
  subject     Subject                      @relation("QualityStageAssignee", fields: [subjectId], references: [id])
  workspaceId String
  stageId     String
  stage       Stage                        @relation(fields: [stageId], references: [id])
  status      QualityStageAssignmentStatus @default(ACTIVE)
  assignedAt  DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@unique([subjectId, workspaceId, stageId])
  @@index([subjectId, workspaceId, status])
  @@index([stageId])
}

model AuditRecord {
  id             String       @id @default(uuid())
  actorSubjectId String?
  actorSubject   Subject?     @relation("AuditActor", fields: [actorSubjectId], references: [id])
  action         String
  resourceType   String
  resourceId     String
  outcome        AuditOutcome
  reason         String?
  correlationId  String?
  detail         Json?
  occurredAt     DateTime     @default(now())

  @@index([resourceType, resourceId, occurredAt])
  @@index([actorSubjectId, occurredAt])
  @@index([correlationId])
}

model OutboxMessage {
  id            String              @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  schemaVersion Int                 @default(1)
  payload       Json
  status        OutboxMessageStatus @default(PENDING)
  availableAt   DateTime            @default(now())
  publishedAt   DateTime?
  attempts      Int                 @default(0)
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model IdempotencyRecord {
  id              String                  @id @default(uuid())
  subjectId       String
  subject         Subject                 @relation(fields: [subjectId], references: [id])
  operation       String
  idempotencyKey  String
  requestHash     String
  status          IdempotencyRecordStatus @default(PENDING)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  expiresAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([subjectId, operation, idempotencyKey])
  @@index([expiresAt])
}

enum Locale {
  EN
  JA
  FIL
}

// Gate 2 identity is deployment-scoped. It intentionally has no Workspace,
// membership-tenancy, or client-selected ProductionLine relation.
enum SubjectStatus {
  ACTIVE
  DISABLED
}

enum SubjectAssignmentKind {
  CAPABILITY
  ROLE_BUNDLE
}

enum SubjectAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Subject {
  id                          String                 @id @default(uuid())
  provider                    String
  issuer                      String
  providerSubject             String
  displayNameSnapshot         String?
  emailSnapshot               String?
  status                      SubjectStatus          @default(ACTIVE)
  createdAt                   DateTime               @default(now())
  updatedAt                   DateTime               @updatedAt
  assignments                 SubjectAssignment[]
  credential                  SubjectCredential?
  stageEventActorRecords      StageEvent[]           @relation("StageEventActor")
  inventoryTransactionRecords InventoryTransaction[] @relation("InventoryTransactionRecorder")
  routingViolationResolutions RoutingViolation[]     @relation("RoutingViolationResolver")
  processChangeRecords        ProcessChangeLog[]     @relation("ProcessChangeActor")
  qualityInspections          QualityInspection[]    @relation("QualityInspectionInspector")
  qualityDecisions            QualityDecision[]      @relation("QualityDecisionActor")
  qualityStageAssignments     QualityStageAssignment[] @relation("QualityStageAssignee")
  releasedPlans               Project[]              @relation("PlanReleaseActor")
  createdBatches              Batch[]                @relation("BatchCreator")
  auditRecords                AuditRecord[]          @relation("AuditActor")
  idempotencyRecords          IdempotencyRecord[]

  @@unique([provider, issuer, providerSubject])
  @@index([status])
}

model SubjectCredential {
  id           String    @id @default(uuid())
  subjectId    String    @unique
  subject      Subject   @relation(fields: [subjectId], references: [id])
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([username])
}

model SubjectAssignment {
  id          String                  @id @default(uuid())
  subjectId   String
  subject     Subject                 @relation(fields: [subjectId], references: [id])
  kind        SubjectAssignmentKind
  key         String
  status      SubjectAssignmentStatus @default(ACTIVE)
  assignedAt  DateTime                @default(now())
  suspendedAt DateTime?
  revokedAt   DateTime?
  version     Int                     @default(1)
  updatedAt   DateTime                @updatedAt

  @@unique([subjectId, kind, key])
  @@index([subjectId, status])
  @@index([kind, key, status])
}

model UserPreference {
  userId         String   @id
  locale         Locale   @default(EN)
  // Completed walkthrough tour keys, e.g. ["dashboard", "station"].
  completedTours String[]
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Source-backed client intake (raw file bytes stay in Drive/object storage)
// ---------------------------------------------------------------------------

enum SourceRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SourceArtifactType {
  WORKBOOK
  PDF
  OTHER
}

enum SourceExtractionStatus {
  COMPLETED
  PARTIAL
  FAILED
}

model SourceRun {
  id          String           @id @default(uuid())
  workspaceId String
  sourceLabel String
  status      SourceRunStatus  @default(RUNNING)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  artifacts   SourceArtifact[]

  @@index([workspaceId, startedAt])
}

model SourceArtifact {
  id               String                 @id @default(uuid())
  sourceRunId      String
  sourceRun        SourceRun              @relation(fields: [sourceRunId], references: [id])
  fileName         String
  artifactType     SourceArtifactType
  mimeType         String
  sizeBytes        Int
  sha256           String
  productCode      String?
  extractionStatus SourceExtractionStatus
  analysis         Json
  reportMarkdown   String
  createdAt        DateTime               @default(now())
  issues           SourceIssue[]
  evidence         SourceEvidence[]

  @@unique([sourceRunId, fileName])
  @@index([sourceRunId])
  @@index([sha256])
}

model SourceIssue {
  id               String           @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact   @relation(fields: [sourceArtifactId], references: [id])
  code             String
  status           String
  severity         String
  message          String
  sheet            String?
  address          String?
  value            Json?
  canonicalValue   Json?
  createdAt        DateTime         @default(now())
  evidence         SourceEvidence[]

  @@index([sourceArtifactId])
  @@index([code, status])
}

// Immutable source coordinates and values used by canonical catalog records. Raw bytes remain in
// Drive/object storage; this table stores only traceable extracted evidence.
model SourceEvidence {
  id               String                    @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact            @relation(fields: [sourceArtifactId], references: [id])
  sourceIssueId    String?
  sourceIssue      SourceIssue?              @relation(fields: [sourceIssueId], references: [id])
  locatorType      SourceEvidenceLocatorType
  sheet            String?
  address          String?
  page             Int?
  rawValue         Json?
  formulaText      String?
  cachedValue      Json?
  normalizedValue  Json?
  quantityBasis    String?
  dependencyState  String?
  evidenceStatus   CanonicalEvidenceStatus
  createdAt        DateTime                  @default(now())
  canonicalLinks   CanonicalEvidenceLink[]
  crosswalks       CanonicalCrosswalk[]

  @@index([sourceArtifactId])
  @@index([sourceIssueId])
  @@index([evidenceStatus])
}

// The subject type is bounded and validated by the catalog application service. This link spans
// the already-existing catalog tables and keeps source evidence reusable without storing arbitrary
// workbook-shaped JSON on Product, Model, or ModelPart.
model CanonicalEvidenceLink {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  relation         String
  createdAt        DateTime                     @default(now())

  @@unique([sourceEvidenceId, subjectType, subjectId, relation])
  @@index([subjectType, subjectId])
}

model CanonicalCrosswalk {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  rawValue         String
  canonicalValue   String
  ruleCode         String
  confidence       Float?
  rationale        String?
  status           CanonicalEvidenceStatus
  createdAt        DateTime                     @default(now())

  @@index([subjectType, subjectId])
  @@index([rawValue])
}

// Durable retry record for canonical draft writes. A row is claimed before the business
// transaction and completed only after the response is known; concurrent reuse is rejected.
model CatalogIdempotencyRecord {
  id              String    @id @default(uuid())
  actorId         String
  operation       String
  idempotencyKey  String
  requestHash     String
  status          Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@unique([actorId, operation, idempotencyKey])
  @@index([createdAt])
}
