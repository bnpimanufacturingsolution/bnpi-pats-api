// ---------------------------------------------------------------------------
// Catalog (admin-authored, generic — no fixed stage enums anywhere)
// ---------------------------------------------------------------------------

enum LinkageMode {
  LINKED
  STANDALONE
}

enum ProductSourceStatus {
  SOURCE_ALIGNED     @map("source-aligned")
  NEEDS_CONFIRMATION @map("needs-confirmation")
  MANUAL
}

enum CatalogLifecycleStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum CanonicalEvidenceStatus {
  CONFIRMED
  INFERRED
  PROVISIONAL
  SOURCE_ANOMALY
  UNAVAILABLE_DEPENDENCY
  NEEDS_CONFIRMATION
  CONFLICTING
  STALE
}

model Product {
  id              String                  @id @default(uuid())
  productCode     String                  @unique
  productName     String
  lifecycleStatus CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus  CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion      Int                     @default(1)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  models          Model[]
  projects        Project[]
}

model Model {
  id                String                    @id @default(uuid())
  productId         String
  product           Product                   @relation(fields: [productId], references: [id])
  modelNumber       String
  modelName         String?
  sourceStatus      ProductSourceStatus
  sourceReference   Json?
  pinned            Boolean                   @default(false)
  lifecycleStatus   CatalogLifecycleStatus    @default(DRAFT)
  evidenceStatus    CanonicalEvidenceStatus   @default(NEEDS_CONFIRMATION)
  rowVersion        Int                       @default(1)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  modelParts        ModelPart[]
  modelRequirements ProjectModelRequirement[]
  projectParts      Part[]                    @relation("ModelProjectParts")

  @@unique([productId, modelNumber])
  @@index([productId])
}

model ModelPart {
  id                String                  @id @default(uuid())
  modelId           String
  model             Model                   @relation(fields: [modelId], references: [id])
  partCode          String
  partName          String
  lifecycleStatus   CatalogLifecycleStatus  @default(DRAFT)
  evidenceStatus    CanonicalEvidenceStatus @default(NEEDS_CONFIRMATION)
  rowVersion        Int                     @default(1)
  createdAt         DateTime                @default(now())
  // Ordered catalog-level StageStepRef[] template. Promotion into a versioned PartsList is
  // intentionally application-controlled until the template contract is confirmed.
  routingSteps      Json
  // Planned/required cycle time, seconds, keyed per route step
  // (`stageId::subStageId`, empty subStageId when stage-wide). Null = unset
  // (honest absence, never zero-filled). Master default consumed by projects;
  // runs snapshot it onto Part at creation.
  plannedCycleTimes Json?
  projectParts      Part[]                  @relation("ModelPartProjectParts")

  @@unique([modelId, partCode])
  @@index([modelId])
}

// A versioned material relationship for one reusable catalog model was removed
// 2026-09-25 under the scoped §7 exception (BomDefinition/BomLine/BomRelationshipKind;
// no production deployment, zero active app callers).

// A versioned, model-applicable process definition was removed 2026-09-25 under the
// scoped §7 exception (ProcessRoute/ProcessRouteStage; no production deployment,
// zero active app callers).

model WorkflowGroup {
  id              String                 @id @default(uuid())
  // Compatibility-only link from the original draft. New configuration is deployment-owned and
  // does not require a planning record.
  projectId       String?
  project         Project?               @relation(fields: [projectId], references: [id])
  name            String
  linkageMode     LinkageMode
  displayOrder    Int
  isSystemSeed    Boolean                @default(false)
  lifecycleStatus CatalogLifecycleStatus @default(DRAFT)
  stages          Stage[]

  @@index([projectId])
}

model Stage {
  id                      String                   @id @default(uuid())
  workflowGroupId         String
  workflowGroup           WorkflowGroup            @relation(fields: [workflowGroupId], references: [id])
  // Manufacturing route stage (for example Injection or Decoration), not floor Section/Process.
  name                    String
  // Server-authored business code shown to operators (e.g. "INJ"). Nullable: no code
  // is better than a fabricated one, and readers must never fall back to the id.
  code                    String?
  // Optional per-locale name overrides: { ja?: string, fil?: string }
  nameLocalized           Json?
  displayOrder            Int
  isSystemSeed            Boolean                  @default(false)
  subStageLinks           SubStageEligibility[]
  stationSteps            StationStep[]
  qualityStageAssignments QualityStageAssignment[]

  @@index([workflowGroupId])
}

model SubStage {
  id                            String                @id @default(uuid())
  name                          String
  // Server-authored business code shown to operators. Nullable; see Stage.code.
  code                          String?
  nameLocalized                 Json?
  displayOrder                  Int
  isSystemSeed                  Boolean               @default(false)
  isConfigurable                Boolean               @default(true)
  isBuffer                      Boolean               @default(false)
  hasQualityCheckpoint          Boolean               @default(false)
  isMandatoryCheckpoint         Boolean               @default(false)
  alwaysAlertOnRoutingViolation Boolean               @default(true)
  subProcessGroup               String?
  isDisabled                    Boolean               @default(false)
  eligibleStages                SubStageEligibility[]
  stationSteps                  StationStep[]
  workProcesses                 WorkProcess[]
}

// A SubStage can be eligible under more than one Stage (the Capsulation/Assortment
// Assembly-vs-Warehouse mechanism) — a join table, not a single parent FK.
model SubStageEligibility {
  stageId    String
  stage      Stage    @relation(fields: [stageId], references: [id])
  subStageId String
  subStage   SubStage @relation(fields: [subStageId], references: [id])

  @@id([stageId, subStageId])
}
enum LotPartAllocationStatus {
  PLANNED
  COMMITTED
  CLOSED
}

enum StageEventStatus {
  RECORDED
  ACCEPTED
  BLOCKED
  CORRECTED
}

enum InventoryTransactionStatus {
  RECORDED
  ACCEPTED
  CORRECTED
}

enum RoutingViolationStatus {
  OPEN
  ACKNOWLEDGED
  RESOLVED
  WAIVED
}

enum QualityInspectionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QualityDecisionType {
  PASSED
  FAILED
  HOLD
}

// ---------------------------------------------------------------------------
// Catalog assets (model image upload)
// ---------------------------------------------------------------------------
// Restored 2026-10-03: the develop schema consolidation dropped this model
// while branch code (assets router, catalog usage, contract tests) and
// migration 20261001080816_add_asset_model_image_upload still reference it.

enum AssetOwnerType {
  MODEL
}

enum AssetStatus {
  REQUESTED
  UPLOAD_REQUESTED
  AVAILABLE
  QUARANTINED
  RETIRED
}

model Asset {
  id             String         @id @default(uuid())
  ownerType      AssetOwnerType
  ownerId        String
  objectKey      String         @unique
  contentType    String
  size           Int
  checksumSha256 String
  status         AssetStatus    @default(REQUESTED)
  rowVersion     Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([ownerType, ownerId, status])
}

// ---------------------------------------------------------------------------
// Execution containers
// ---------------------------------------------------------------------------

enum BatchStatus {
  PLANNED
  ACTIVE
  HELD
  CLOSED
  SCRAPPED
}

model Batch {
  id                        String                   @id @default(uuid())
  batchCode                 String                   @unique
  barcodeValue              String                   @unique
  lotId                     String
  lot                       Lot                      @relation(fields: [lotId], references: [id])
  /**
   * Physical line this batch is published to; null = not yet assigned to a line.
   */
  lineId                    String?
  line                      Line?                    @relation(fields: [lineId], references: [id])
  plannedQuantity           Int
  labelPackSize             Int
  projectModelRequirementId String?
  projectModelRequirement   ProjectModelRequirement? @relation(fields: [projectModelRequirementId], references: [id])
  seriesNumber              Int?
  seriesCount               Int?
  partId                    String
  part                      Part                     @relation(fields: [partId], references: [id])
  currentStageId            String
  currentSubStageId         String?
  status                    BatchStatus              @default(PLANNED)
  rowVersion                Int                      @default(1)
  createdBySubjectId        String?
  createdBySubject          Subject?                 @relation("BatchCreator", fields: [createdBySubjectId], references: [id])
  createdAt                 DateTime                 @default(now())
  positionProjection        BatchPositionProjection?
  qualityInspections        QualityInspection[]
  defectAnalyses            DefectAnalysis[]

  @@index([lotId])
  @@index([partId])
  @@index([projectModelRequirementId])
  @@index([currentStageId])
  @@index([lineId])
}

// ---------------------------------------------------------------------------
// Execution ledger (append-oriented, auditable)
// ---------------------------------------------------------------------------

enum StageEventType {
  STAGE_SCAN_RECORDED
  ROUTE_VALIDATED
  ROUTING_VIOLATION_DETECTED
  STAGE_COMPLETED
  VARIANCE_FLAG_RAISED
}

model StageEvent {
  id                   String            @id @default(uuid())
  stageId              String
  subStageId           String?
  eventType            StageEventType
  batchId              String
  lotId                String
  partId               String?
  quantity             Int?
  occurredAt           DateTime
  actor                String
  isRoutingViolation   Boolean           @default(false)
  status               StageEventStatus  @default(RECORDED)
  routeStepId          String?
  routeStep            RoutingStep?      @relation(fields: [routeStepId], references: [id])
  actorSubjectId       String?
  actorSubject         Subject?          @relation("StageEventActor", fields: [actorSubjectId], references: [id])
  quantityMagnitude    Decimal?          @db.Decimal(18, 6)
  quantityUom          String?
  usageBasis           String?
  sourceRepresentation String?
  routingViolation     RoutingViolation?

  @@index([batchId, occurredAt])
  @@index([stageId])
}

enum InventoryTransactionType {
  RECEIVING
  ISSUANCE
}

model InventoryTransaction {
  id                        String                     @id @default(uuid())
  transactionType           InventoryTransactionType
  batchId                   String
  part                      Part                       @relation(fields: [partId], references: [id])
  partId                    String
  lotId                     String
  fromStageId               String?
  fromSubStageId            String?
  toStageId                 String
  toSubStageId              String?
  expectedQuantity          Int
  actualQuantity            Int
  withdrawalFormRef         String?
  recordedAt                DateTime
  recordedBy                String
  status                    InventoryTransactionStatus @default(RECORDED)
  expectedQuantityMagnitude Decimal?                   @db.Decimal(18, 6)
  actualQuantityMagnitude   Decimal?                   @db.Decimal(18, 6)
  quantityUom               String?
  usageBasis                String?
  sourceRepresentation      String?
  recordedBySubjectId       String?
  recordedBySubject         Subject?                   @relation("InventoryTransactionRecorder", fields: [recordedBySubjectId], references: [id])

  @@index([batchId, recordedAt])
  @@index([lotId])
}

model RoutingViolation {
  id                  String                 @id @default(uuid())
  stageEventId        String                 @unique
  stageEvent          StageEvent             @relation(fields: [stageEventId], references: [id])
  batchId             String
  lotId               String
  partId              String
  attemptedStageId    String
  attemptedSubStageId String?
  // The allowed route at detection time, denormalized as [{stageId, subStageId, order}] so the
  // violation stays auditable even after the PartsList is versioned forward.
  expectedSteps       Json
  detectedAt          DateTime
  resolved            Boolean                @default(false)
  status              RoutingViolationStatus @default(OPEN)
  resolvedAt          DateTime?
  resolvedBy          String?
  resolvedBySubjectId String?
  resolvedBySubject   Subject?               @relation("RoutingViolationResolver", fields: [resolvedBySubjectId], references: [id])
  resolutionNote      String?

  @@index([batchId])
  @@index([resolved])
}

model ProcessChangeLog {
  id                 String   @id @default(uuid())
  projectId          String
  project            Project  @relation(fields: [projectId], references: [id])
  lotId              String
  batchId            String?
  partId             String
  previousStageId    String
  previousSubStageId String?
  newStageId         String
  newSubStageId      String?
  actor              String
  actorSubjectId     String?
  actorSubject       Subject? @relation("ProcessChangeActor", fields: [actorSubjectId], references: [id])
  reason             String
  changedAt          DateTime

  @@index([projectId, changedAt])
}

model LotPartAllocation {
  id                String                  @id @default(uuid())
  lotId             String
  lot               Lot                     @relation(fields: [lotId], references: [id])
  partId            String
  part              Part                    @relation(fields: [partId], references: [id])
  quantityMagnitude Decimal                 @db.Decimal(18, 6)
  quantityUom       String
  usageBasis        String?
  status            LotPartAllocationStatus @default(PLANNED)
  rowVersion        Int                     @default(1)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@unique([lotId, partId])
  @@index([partId])
}

model BatchPositionProjection {
  batchId           String           @id
  batch             Batch            @relation(fields: [batchId], references: [id])
  stageId           String
  subStageId        String?
  routeStepId       String?
  lastEventId       String?          @unique
  positionStatus    StageEventStatus @default(ACCEPTED)
  quantityMagnitude Decimal?         @db.Decimal(18, 6)
  quantityUom       String?
  projectionVersion Int              @default(1)
  updatedAt         DateTime         @updatedAt

  @@index([stageId, subStageId])
}

model QualityInspection {
  id                   String                  @id @default(uuid())
  batchId              String
  batch                Batch                   @relation(fields: [batchId], references: [id])
  stageId              String
  subStageId           String?
  sectionId            String?
  inspectedQuantity    Decimal?                @db.Decimal(18, 6)
  quantityUom          String?
  status               QualityInspectionStatus @default(OPEN)
  inspectedBySubjectId String?
  inspectedBySubject   Subject?                @relation("QualityInspectionInspector", fields: [inspectedBySubjectId], references: [id])
  evidence             Json?
  startedAt            DateTime                @default(now())
  completedAt          DateTime?
  rowVersion           Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  decisions            QualityDecision[]
  defectAnalysis       DefectAnalysis?

  @@index([batchId, createdAt])
  @@index([status, createdAt])
}

enum DefectDisposition {
  REWORK
  SCRAP
  WAIVE
}

model QualityDecision {
  id                 String            @id @default(uuid())
  inspectionId       String
  inspection         QualityInspection @relation(fields: [inspectionId], references: [id])
  decision           QualityDecisionType
  decidedBySubjectId String?
  decidedBySubject   Subject?          @relation("QualityDecisionActor", fields: [decidedBySubjectId], references: [id])
  decidedAt          DateTime          @default(now())

  @@index([inspectionId, decidedAt])
}

model DefectAnalysis {
  id                 String            @id @default(uuid())
  inspectionId       String            @unique
  inspection         QualityInspection @relation(fields: [inspectionId], references: [id])
  batchId            String
  batch              Batch             @relation(fields: [batchId], references: [id])
  reasonCode         String
  reasonNote         String?
  disposition        DefectDisposition
  decidedBySubjectId String?
  decidedBySubject   Subject?          @relation("DefectAnalysisActor", fields: [decidedBySubjectId], references: [id])
  decidedAt          DateTime          @default(now())
  rowVersion         Int               @default(1)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([batchId, decidedAt])
}

enum QualityStageAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

/// Journey D stage allow-list (v1 stage grain only). Not a SubjectAssignment.key.
/// Fail closed: quality.resolve with zero ACTIVE rows cannot create/decide.
model QualityStageAssignment {
  id          String                       @id @default(uuid())
  subjectId   String
  subject     Subject                      @relation("QualityStageAssignee", fields: [subjectId], references: [id])
  workspaceId String
  stageId     String
  stage       Stage                        @relation(fields: [stageId], references: [id])
  status      QualityStageAssignmentStatus @default(ACTIVE)
  assignedAt  DateTime                     @default(now())
  updatedAt   DateTime                     @updatedAt

  @@unique([subjectId, workspaceId, stageId])
  @@index([subjectId, workspaceId, status])
  @@index([stageId])
}
// ---------------------------------------------------------------------------
// Stations, localization, walkthrough (2026-07-07 model additions)
// ---------------------------------------------------------------------------

enum ScreenType {
  COMPUTER
  TABLET
}

model ProductionLine {
  id           String    @id @default(uuid())
  lineCode     String    @unique
  name         String
  displayOrder Int       @default(0)
  isEnabled    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sections     Section[]
  machines     Machine[]
}

// Optional equipment identity owned by a ProductionLine. `machineCode` is the
// operational key a scan or label refers to; `name` is display text. A line with
// no machines simply has no rows - the field is optional rather than defaulted,
// so "not configured" stays distinguishable from "configured as blank".
//
// Every field here is dictated by code that already existed before this model
// did: `command-router.ts` create/patch/delete handlers and the
// `productionLineMachine*` read routes, plus their passing contract tests. The
// model was missing, which is why `DomainReadDatabase` could not be satisfied by
// a real `PrismaClient` and `npm run type-check` failed. Row shape and defaults
// mirror `ProductionLine` above (`rowVersion` for the If-Match/ETag contract,
// `displayOrder`, `isEnabled` for the soft-delete the delete handler performs).
model Machine {
  id              String        @id @default(uuid())
  productionLineId String
  productionLine  ProductionLine @relation(fields: [productionLineId], references: [id])
  machineCode     String        @unique
  name            String
  displayOrder    Int           @default(0)
  isEnabled       Boolean       @default(true)
  rowVersion      Int           @default(1)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([productionLineId])
}

model Section {
  id                    String          @id @default(uuid())
  workspaceId           String
  name                  String
  // Nullable during the compatibility bridge; all new API-created sections require a code.
  sectionCode           String?         @unique
  operationalContextKey String          @default("PATS")
  productionLineId      String?
  productionLine        ProductionLine? @relation(fields: [productionLineId], references: [id])
  stageId               String
  screenType            ScreenType      @default(COMPUTER)
  scannerAttached       Boolean         @default(true)
  printerAttached       Boolean         @default(true)
  displayOrder          Int
  isEnabled             Boolean         @default(true)
  printerConnection     String?
  printerAddress        String?
  printerLanguage       String?
  printerDpi            Int?
  printerModel          String?
  labelWidthMm          Int?
  labelHeightMm         Int?
  printerAgent          String?
  boundSteps            StationStep[]
  booths                Booth[]
  lines                 Line[]
  printJobs             PrintJob[]

  @@index([workspaceId])
  @@index([productionLineId])
}

enum PrintJobStatus {
  QUEUED
  SENT
  FAILED
  SIMULATED
}

model PrintJob {
  id              String         @id @default(uuid())
  batchId         String
  sectionId       String
  section         Section        @relation(fields: [sectionId], references: [id])
  fromStageId     String
  fromSubStageId  String?
  toStageId       String?
  toSubStageId    String?
  barcodeValue    String
  quantity        Int
  sequence        Int
  reprintOf       String?
  language        String
  renderedPayload String
  status          PrintJobStatus @default(QUEUED)
  failureReason   String?
  actor           String
  actorSubjectId  String?
  occurredAt      DateTime       @default(now())

  @@index([batchId, occurredAt])
  @@index([sectionId, occurredAt])
}

/// Floor work-process node in the Section → Process → Sub-process tree. Not a device mount.
/// The SubStage link is an optional explicit manufacturing-route mapping, never inferred.
model WorkProcess {
  id              String                   @id @default(uuid())
  subStageId      String?
  subStage        SubStage?                @relation(fields: [subStageId], references: [id])
  sectionId       String?
  parentProcessId String?
  parentProcess   WorkProcess?             @relation("WorkProcessChildren", fields: [parentProcessId], references: [id])
  children        WorkProcess[]            @relation("WorkProcessChildren")
  name            String
  displayOrder    Int
  isEnabled       Boolean                  @default(true)
  isSystemSeed    Boolean                  @default(false)
  booths          Booth[]
  lines           Line[]
  dailySheets     MonitoringDailySheet[]
  stationBoards   MonitoringStationBoard[]

  @@index([subStageId])
  @@index([name])
  @@index([sectionId])
  @@index([parentProcessId])
}

/// Station-screen line instance (1 line = 1 screen). Leaf-owned: hangs under a
/// leaf WorkProcess; parent counts roll up. Identity is place, not person.
model Line {
  id                  String                   @id @default(uuid())
  sectionId           String
  section             Section                  @relation(fields: [sectionId], references: [id])
  processId           String
  workProcess         WorkProcess              @relation(fields: [processId], references: [id])
  lineCode            String                   @unique
  label               String?
  assignedLeaderId    String
  assignedLeader      Subject                  @relation("LineAssignedLeader", fields: [assignedLeaderId], references: [id])
  activeLeaderId      String?
  activeLeader        Subject?                 @relation("LineActiveLeader", fields: [activeLeaderId], references: [id])
  displayOrder        Int
  isEnabled           Boolean                  @default(true)
  operatorAssignments LineOperatorAssignment[]
  batches             Batch[]
  rowVersion          Int                      @default(1)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([sectionId])
  @@index([processId])
  @@index([activeLeaderId])
}

enum LineOperatorAssignmentStatus {
  ACTIVE
  ENDED
}

/// Operator-on-line assignment (single-line invariant). Ending a row creates
/// ENDED evidence; rows are never rewritten except to end them.
model LineOperatorAssignment {
  id             String                       @id @default(uuid())
  lineId         String
  line           Line                         @relation(fields: [lineId], references: [id])
  subjectId      String
  subject        Subject                      @relation("LineOperatorAssignmentSubject", fields: [subjectId], references: [id])
  reason         String?
  status         LineOperatorAssignmentStatus @default(ACTIVE)
  actorSubjectId String
  startedAt      DateTime                     @default(now())
  endedAt        DateTime?

  @@index([subjectId, status])
  @@index([lineId, status])
}

/// Physical floor capacity cell. Many booths may share one Station PC (1:N).
model Booth {
  id            String                   @id @default(uuid())
  workspaceId   String
  boothCode     String
  label         String?
  sectionId     String?
  section       Section?                 @relation(fields: [sectionId], references: [id])
  stageId       String
  subStageId    String?
  workProcessId String?
  workProcess   WorkProcess?             @relation(fields: [workProcessId], references: [id])
  displayOrder  Int
  isEnabled     Boolean                  @default(true)
  stationBoards MonitoringStationBoard[]

  @@unique([workspaceId, boothCode])
  @@index([sectionId])
  @@index([stageId, subStageId])
}

/// Line Leader day encode (durable). payload mirrors app DailyMonitoringSheet fields.
model MonitoringDailySheet {
  id                  String       @id @default(uuid())
  workspaceId         String
  productionDate      String
  lineLabel           String
  workProcessId       String?
  workProcess         WorkProcess? @relation(fields: [workProcessId], references: [id])
  processName         String
  lineLeaderName      String       @default("")
  productName         String       @default("")
  modelName           String       @default("")
  partName            String       @default("")
  lotCode             String       @default("")
  targetPerShift      Int          @default(0)
  hourlyTarget        Int          @default(0)
  operatorNames       String       @default("")
  inputPartsAvailable Int?
  defectiveQty        Int?
  status              String       @default("draft")
  slotsJson           Json
  payloadJson         Json
  rowVersion          Int          @default(1)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([workspaceId, productionDate])
  @@index([workProcessId])
}

/// Process Station Board encode (booth-level). payload mirrors app StationBoardEntry.
model MonitoringStationBoard {
  id                   String       @id @default(uuid())
  workspaceId          String
  productionDate       String
  boothId              String?
  booth                Booth?       @relation(fields: [boothId], references: [id])
  workProcessId        String?
  workProcess          WorkProcess? @relation(fields: [workProcessId], references: [id])
  boothLabel           String       @default("")
  processName          String       @default("")
  partName             String       @default("")
  lotCode              String       @default("")
  labelledCycleTimeSec Int          @default(0)
  targetPerHour        Int          @default(0)
  targetPerDay         Int          @default(0)
  slotsJson            Json
  payloadJson          Json
  rowVersion           Int          @default(1)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([workspaceId, productionDate])
  @@index([boothId])
}

model StationStep {
  sectionId  String
  section    Section   @relation(fields: [sectionId], references: [id])
  stageId    String
  stage      Stage     @relation(fields: [stageId], references: [id])
  subStageId String?
  subStage   SubStage? @relation(fields: [subStageId], references: [id])
  // Composite id needs a non-null member for subStageId-null base steps.
  id         String    @id @default(uuid())

  @@unique([sectionId, stageId, subStageId])
}

model WorkInstruction {
  id                String             @id @default(uuid())
  stageId           String
  subStageId        String?
  // Ordered steps, each a LocalizedText: [{ en, ja?, fil? }, ...]
  steps             Json
  version           Int                @default(1)
  status            RouteVersionStatus @default(DRAFT)
  sourceRevisionRef String?
  updatedAt         DateTime           @updatedAt

  @@unique([stageId, subStageId, version])
}
enum AuditOutcome {
  SUCCESS
  FAILURE
}

enum OutboxMessageStatus {
  PENDING
  PUBLISHED
  FAILED
  DEAD_LETTERED
}

enum IdempotencyRecordStatus {
  PENDING
  COMPLETED
  EXPIRED
}

enum SourceEvidenceLocatorType {
  WORKBOOK_CELL
  WORKBOOK_RANGE
  PDF_PAGE
  PDF_TEXT
  OTHER
}

enum CanonicalEvidenceSubjectType {
  PRODUCT
  MODEL
  MODEL_PART
}

model AuditRecord {
  id             String       @id @default(uuid())
  actorSubjectId String?
  actorSubject   Subject?     @relation("AuditActor", fields: [actorSubjectId], references: [id])
  action         String
  resourceType   String
  resourceId     String
  outcome        AuditOutcome
  reason         String?
  correlationId  String?
  detail         Json?
  occurredAt     DateTime     @default(now())

  @@index([resourceType, resourceId, occurredAt])
  @@index([actorSubjectId, occurredAt])
  @@index([correlationId])
}

model OutboxMessage {
  id            String              @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  schemaVersion Int                 @default(1)
  payload       Json
  status        OutboxMessageStatus @default(PENDING)
  availableAt   DateTime            @default(now())
  publishedAt   DateTime?
  attempts      Int                 @default(0)
  lastError     String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId, createdAt])
}

model IdempotencyRecord {
  id              String                  @id @default(uuid())
  subjectId       String
  subject         Subject                 @relation(fields: [subjectId], references: [id])
  operation       String
  idempotencyKey  String
  requestHash     String
  status          IdempotencyRecordStatus @default(PENDING)
  responseStatus  Int?
  responseBody    Json?
  responseHeaders Json?
  expiresAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@unique([subjectId, operation, idempotencyKey])
  @@index([expiresAt])
}

enum Locale {
  EN
  JA
  FIL
}

// Gate 2 identity is deployment-scoped. It intentionally has no Workspace,
// membership-tenancy, or client-selected ProductionLine relation.
enum SubjectStatus {
  ACTIVE
  DISABLED
}

enum SubjectAssignmentKind {
  CAPABILITY
  ROLE_BUNDLE
}

enum SubjectAssignmentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}

model Subject {
  id                          String                   @id @default(uuid())
  provider                    String
  issuer                      String
  providerSubject             String
  displayNameSnapshot         String?
  emailSnapshot               String?
  status                      SubjectStatus            @default(ACTIVE)
  createdAt                   DateTime                 @default(now())
  updatedAt                   DateTime                 @updatedAt
  assignments                 SubjectAssignment[]
  credential                  SubjectCredential?
  stageEventActorRecords      StageEvent[]             @relation("StageEventActor")
  inventoryTransactionRecords InventoryTransaction[]   @relation("InventoryTransactionRecorder")
  routingViolationResolutions RoutingViolation[]       @relation("RoutingViolationResolver")
  processChangeRecords        ProcessChangeLog[]       @relation("ProcessChangeActor")
  qualityInspections          QualityInspection[]      @relation("QualityInspectionInspector")
  qualityDecisions            QualityDecision[]        @relation("QualityDecisionActor")
  defectAnalysisRecords     DefectAnalysis[]         @relation("DefectAnalysisActor")
  qualityStageAssignments     QualityStageAssignment[] @relation("QualityStageAssignee")
  releasedPlans               Project[]                @relation("PlanReleaseActor")
  completedProjects           Project[]                @relation("ProjectCompletionActor")
  createdBatches              Batch[]                  @relation("BatchCreator")
  auditRecords                AuditRecord[]            @relation("AuditActor")
  idempotencyRecords          IdempotencyRecord[]
  assignedLines               Line[]                   @relation("LineAssignedLeader")
  activeLines                 Line[]                   @relation("LineActiveLeader")
  lineOperatorAssignments     LineOperatorAssignment[] @relation("LineOperatorAssignmentSubject")

  @@unique([provider, issuer, providerSubject])
  @@index([status])
}

model SubjectCredential {
  id           String    @id @default(uuid())
  subjectId    String    @unique
  subject      Subject   @relation(fields: [subjectId], references: [id])
  username     String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([username])
}

model SubjectAssignment {
  id          String                  @id @default(uuid())
  subjectId   String
  subject     Subject                 @relation(fields: [subjectId], references: [id])
  kind        SubjectAssignmentKind
  key         String
  status      SubjectAssignmentStatus @default(ACTIVE)
  assignedAt  DateTime                @default(now())
  suspendedAt DateTime?
  revokedAt   DateTime?
  version     Int                     @default(1)
  updatedAt   DateTime                @updatedAt

  @@unique([subjectId, kind, key])
  @@index([subjectId, status])
  @@index([kind, key, status])
}

model UserPreference {
  userId         String   @id
  locale         Locale   @default(EN)
  // Completed walkthrough tour keys, e.g. ["dashboard", "station"].
  completedTours String[]
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Source-backed client intake (raw file bytes stay in Drive/object storage)
// ---------------------------------------------------------------------------

enum SourceRunStatus {
  RUNNING
  COMPLETED
  PARTIAL
  FAILED
}

enum SourceArtifactType {
  WORKBOOK
  PDF
  OTHER
}

enum SourceExtractionStatus {
  COMPLETED
  PARTIAL
  FAILED
}

model SourceRun {
  id          String           @id @default(uuid())
  workspaceId String
  sourceLabel String
  status      SourceRunStatus  @default(RUNNING)
  startedAt   DateTime         @default(now())
  completedAt DateTime?
  artifacts   SourceArtifact[]

  @@index([workspaceId, startedAt])
}

model SourceArtifact {
  id               String                 @id @default(uuid())
  sourceRunId      String
  sourceRun        SourceRun              @relation(fields: [sourceRunId], references: [id])
  fileName         String
  artifactType     SourceArtifactType
  mimeType         String
  sizeBytes        Int
  sha256           String
  productCode      String?
  extractionStatus SourceExtractionStatus
  analysis         Json
  reportMarkdown   String
  createdAt        DateTime               @default(now())
  issues           SourceIssue[]
  evidence         SourceEvidence[]

  @@unique([sourceRunId, fileName])
  @@index([sourceRunId])
  @@index([sha256])
}

model SourceIssue {
  id               String           @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact   @relation(fields: [sourceArtifactId], references: [id])
  code             String
  status           String
  severity         String
  message          String
  sheet            String?
  address          String?
  value            Json?
  canonicalValue   Json?
  createdAt        DateTime         @default(now())
  evidence         SourceEvidence[]

  @@index([sourceArtifactId])
  @@index([code, status])
}

// Immutable source coordinates and values used by canonical catalog records. Raw bytes remain in
// Drive/object storage; this table stores only traceable extracted evidence.
model SourceEvidence {
  id               String                    @id @default(uuid())
  sourceArtifactId String
  sourceArtifact   SourceArtifact            @relation(fields: [sourceArtifactId], references: [id])
  sourceIssueId    String?
  sourceIssue      SourceIssue?              @relation(fields: [sourceIssueId], references: [id])
  locatorType      SourceEvidenceLocatorType
  sheet            String?
  address          String?
  page             Int?
  rawValue         Json?
  formulaText      String?
  cachedValue      Json?
  normalizedValue  Json?
  quantityBasis    String?
  dependencyState  String?
  evidenceStatus   CanonicalEvidenceStatus
  createdAt        DateTime                  @default(now())
  canonicalLinks   CanonicalEvidenceLink[]
  crosswalks       CanonicalCrosswalk[]

  @@index([sourceArtifactId])
  @@index([sourceIssueId])
  @@index([evidenceStatus])
}

// The subject type is bounded and validated by the catalog application service. This link spans
// the already-existing catalog tables and keeps source evidence reusable without storing arbitrary
// workbook-shaped JSON on Product, Model, or ModelPart.
model CanonicalEvidenceLink {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  relation         String
  createdAt        DateTime                     @default(now())

  @@unique([sourceEvidenceId, subjectType, subjectId, relation])
  @@index([subjectType, subjectId])
}

model CanonicalCrosswalk {
  id               String                       @id @default(uuid())
  sourceEvidenceId String
  sourceEvidence   SourceEvidence               @relation(fields: [sourceEvidenceId], references: [id])
  subjectType      CanonicalEvidenceSubjectType
  subjectId        String
  rawValue         String
  canonicalValue   String
  ruleCode         String
  confidence       Float?
  rationale        String?
  status           CanonicalEvidenceStatus
  createdAt        DateTime                     @default(now())

  @@index([subjectType, subjectId])
  @@index([rawValue])
}

// Durable retry record for canonical draft writes. A row is claimed before the business
// transaction and completed only after the response is known; concurrent reuse is rejected.
model CatalogIdempotencyRecord {
  id              String    @id @default(uuid())
  actorId         String
  operation       String
  idempotencyKey  String
  requestHash     String
  status          Int?
  responseBody    Json?
  responseHeaders Json?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?

  @@unique([actorId, operation, idempotencyKey])
  @@index([createdAt])
}
// Canonical planning and execution lifecycle vocabularies. The older draft models remain
// physical compatibility tables while the API exposes the canonical resource names.
enum ProjectLifecycleStatus {
  DRAFT
  RELEASED
  COMPLETED
}

enum RouteVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
}

enum LotStatus {
  PLANNED
  ACTIVE
  HELD
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Planning definition
// ---------------------------------------------------------------------------

model Project {
  id                         String                    @id @default(uuid())
  workspaceId                String
  projectCode                String                    @unique
  name                       String
  requiredProductionQuantity Int                       @default(0)
  status                     ProjectLifecycleStatus    @default(DRAFT)
  rowVersion                 Int                       @default(1)
  releasedAt                 DateTime?
  releasedBySubjectId        String?
  releasedBySubject          Subject?                  @relation("PlanReleaseActor", fields: [releasedBySubjectId], references: [id])
  completedAt                DateTime?
  completedBySubjectId       String?
  completedBySubject         Subject?                  @relation("ProjectCompletionActor", fields: [completedBySubjectId], references: [id])
  // Planned production window. The model's FIRST plan dates (client request
  // 2026-10-02: "where is the start and end date here?").
  //
  // Named `planned*` deliberately, and not `startDate`/`endDate`: the fields they
  // sit beside — `releasedAt`, `completedAt` — are ACTUALS. A bare "Start"/"End"
  // beside two actuals reads as actuals too, which is exactly the confusion that
  // made `createdAt` unusable as a start date (all 15 seeded projects share one
  // `createdAt` constant, so it is a seed artifact, not a schedule).
  //
  // Nullable with NO default and NO backfill, on purpose. Backfilling would invent
  // a schedule for every existing project — the fabrication the app-side honesty
  // rules (`display-human-readable-codes`, the lot card's own "no date" decision)
  // exist to prevent. An unset window is an honest absence.
  plannedStartDate           DateTime?
  plannedEndDate             DateTime?
  productId                  String?
  product                    Product?                  @relation(fields: [productId], references: [id])
  createdAt                  DateTime                  @default(now())
  productSpecification       ProductSpecification?
  modelRequirements          ProjectModelRequirement[]
  partsLists                 PartsList[]
  workflowGroups             WorkflowGroup[]
  parts                      Part[]
  lot                        Lot?
  processChangeLogs          ProcessChangeLog[]

  @@index([workspaceId])
  @@index([productId])
}

model ProjectModelRequirement {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id])
  modelId          String
  model            Model    @relation(fields: [modelId], references: [id])
  requiredQuantity Int
  createdAt        DateTime @default(now())
  batches          Batch[]
  parts            Part[]

  @@unique([projectId, modelId])
  @@index([projectId])
  @@index([modelId])
}

model ProductSpecification {
  id                   String   @id @default(uuid())
  projectId            String   @unique
  project              Project  @relation(fields: [projectId], references: [id])
  skuCode              String
  productName          String
  trayQuantityStandard Int
  sourceRevisionRef    String?
  rowVersion           Int      @default(1)
  createdAt            DateTime @default(now())
}

model PartsList {
  id                String             @id @default(uuid())
  projectId         String
  project           Project            @relation(fields: [projectId], references: [id])
  version           Int
  status            RouteVersionStatus @default(DRAFT)
  sourceRevisionRef String?
  publishedAt       DateTime?
  rowVersion        Int                @default(1)
  createdAt         DateTime           @default(now())
  steps             RoutingStep[]

  @@unique([projectId, version])
}

// One ordered routing step for one Part inside one PartsList version — the frontend's
// PartsListEntry.routingSteps flattened into rows. Ordering is the point: an unordered set
// cannot express "Full Spray -> Mask Spray -> Tampo".
model RoutingStep {
  id          String       @id @default(uuid())
  partsListId String
  partsList   PartsList    @relation(fields: [partsListId], references: [id])
  partId      String
  part        Part         @relation(fields: [partId], references: [id])
  stageId     String
  subStageId  String?
  stepOrder   Int
  stageEvents StageEvent[]

  @@unique([partsListId, partId, stepOrder])
  @@index([partId])
}

model Part {
  id                        String                   @id @default(uuid())
  projectId                 String
  project                   Project                  @relation(fields: [projectId], references: [id])
  partCode                  String
  partName                  String
  sourceModelId             String?
  sourceModel               Model?                   @relation("ModelProjectParts", fields: [sourceModelId], references: [id])
  sourceModelPartId         String?
  sourceModelPart           ModelPart?               @relation("ModelPartProjectParts", fields: [sourceModelPartId], references: [id])
  projectModelRequirementId String?
  projectModelRequirement   ProjectModelRequirement? @relation(fields: [projectModelRequirementId], references: [id])
  // Hybrid per-part variance tolerance — either, both, or neither bound may be set;
  // application falls back to the system default (5%) when both are null.
  variancePercentThreshold  Float?
  varianceAbsoluteFloor     Int?
  // Planned/required cycle time snapshot, seconds per route step — copied from
  // the catalog ModelPart at project creation (runs freeze master values,
  // like parts-list versioning).
  plannedCycleTimes         Json?
  // Finalization edit; null = use the snapshot above (master fallback chain).
  plannedCycleTimesOverride Json?
  lifecycleStatus           CatalogLifecycleStatus   @default(DRAFT)
  rowVersion                Int                      @default(1)
  routingSteps              RoutingStep[]
  lotPartAllocations        LotPartAllocation[]
  inventoryTransactions     InventoryTransaction[]
  batches                   Batch[]

  @@unique([projectId, partCode])
  @@index([sourceModelId])
  @@index([sourceModelPartId])
  @@index([projectModelRequirementId])
}

model Lot {
  id                         String              @id @default(uuid())
  projectId                  String              @unique
  project                    Project             @relation(fields: [projectId], references: [id])
  lotCode                    String              @unique
  lotName                    String
  partsListId                String
  partsListVersion           Int
  requiredProductionQuantity Int
  status                     LotStatus           @default(PLANNED)
  // Structured replacement for the PRD's free-text labelBreakdown (whiteboard stage-1 math:
  // requiredProductionQuantity / labelPackSize = countable labels, e.g. 100,000 / 200 = 500). Label counts
  // are derived by the application, never stored.
  labelPackSize              Int
  // Lot numbers are assigned once at Planning and never reassigned (client doc, stage 1).
  createdAtStage             String              @default("Planning")
  createdAt                  DateTime            @default(now())
  batches                    Batch[]
  partAllocations            LotPartAllocation[]
}

// ---------------------------------------------------------------------------
// Canonical planning, projections, quality, and platform records
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client-js"
  output   = "../../generated/pats-client"
}

datasource db {
  provider = "postgresql"
  url      = env("PATS_DATABASE_URL")
}
