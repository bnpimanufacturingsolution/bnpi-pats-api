    "requestBody": {
      "required": true,
      "schema": {
        "type": "object",
        "required": [
          "employeeNumber",
          "firstName",
          "lastName",
          "email"
        ],
        "properties": {
          "employeeNumber": {
            "type": "string",
            "example": "EMP-001"
          },
          "firstName": {
            "type": "string",
            "example": "John"
          },
          "middleName": {
            "type": "string"
          },
          "lastName": {
            "type": "string",
            "example": "Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "john.doe@company.com"
          },
          "phone": {
            "type": "string"
          },
          "department": {
            "type": "string"
          },
          "position": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "ON_LEAVE",
              "TERMINATED",
              "SUSPENDED"
            ],
            "default": "ACTIVE"
          }
        }
      },
      "contentTypes": [
        "application/json"
      ]
    },
    "responses": {
      "201": {
        "description": "Employee created",
        "contentTypes": []
      },
      "400": {
        "contentTypes": []
      },
      "409": {
        "description": "Duplicate email or employee number",
        "contentTypes": []
      }
    },
