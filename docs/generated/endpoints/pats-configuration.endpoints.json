      "PATS Configuration"
    ],
    "deprecated": false,
    "security": [
      {
        "bearerAuth": []
      }
    ],
    "contentTypes": [],
    "pathParams": [],
    "queryParams": [
      {
        "name": "page",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        }
      },
      {
        "name": "limit",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      {
        "name": "search",
        "schema": {
          "type": "string"
        }
      }
    ],
    "responses": {
      "200": {
        "description": "Paginated production-line summaries",
        "contentTypes": []
      },
      "400": {
        "description": "Malformed or incomplete collection query",
        "contentTypes": []
      },
      "403": {
        "description": "execution.read capability required",
        "contentTypes": []
      },
      "503": {
        "description": "Production-line data unavailable",
        "contentTypes": []
      }
    },
    "paginationHints": {
      "hasPaginationParams": true,
      "hasSearchParam": false,
      "hasSortParams": false
    }
