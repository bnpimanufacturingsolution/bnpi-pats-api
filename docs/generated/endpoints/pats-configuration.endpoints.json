  {
    "id": "lineCreate",
    "method": "POST",
    "url": "/lines",
    "summary": "Register a station-screen line under a leaf work process",
    "description": "1 line = 1 station screen (L-1). The line must attach to a leaf WorkProcess; parent counts roll up (L-2/L-4). assignedLeaderId is required at creation time (L-5); the active leader defaults to the assigned leader. lineCode must be uppercase alphanumeric with dashes (e.g. DEC-LS-01) and is unique across the deployment.\n",
    "tags": [
      "PATS Configuration"
    ],
