  {
    "id": "lineCollectionGet",
    "method": "GET",
    "url": "/lines",
    "summary": "Read station-screen line instances scoped to the caller",
    "description": "1 line = 1 station screen. Admin (operations.manage) sees all lines; every other subject sees only lines where they are the active leader, the assigned leader, or hold an ACTIVE operator assignment. This collection is the login-landing source: one allowed line lands directly, several show the picker.\n",
    "tags": [
      "PATS Configuration"
    ],
    "deprecated": false,
    "contentTypes": [],
    "pathParams": [],
    "queryParams": [
      {
        "name": "section_id",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      {
        "name": "process_id",
        "schema": {
          "type": "string",
          "minLength": 1
        }
      },
      {
        "name": "include_disabled",
        "schema": {
          "type": "boolean",
          "default": false
        }
      }
    ],
    "responses": {
      "200": {
        "contentTypes": []
      },
      "400": {
        "contentTypes": []
      },
      "403": {
        "contentTypes": []
      },
      "503": {
        "contentTypes": []
      }
