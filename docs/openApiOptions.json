{
	"failOnErrors": true,
	"definition": {
		"openapi": "3.1.0",
		"info": {
			"title": "Bandai PATS API",
			"version": "1.0.0",
			"description": "Welcome to the Bandai PATS API documentation. This REST API powers Bandai PATS backend services.",
			"contact": {
				"name": "Bandai PATS Support",
				"email": "support@bandai-pats.example",
				"url": "https://bandai-pats.example/support"
			},
			"license": {
				"name": "MIT",
				"url": "https://opensource.org/licenses/MIT"
			},
			"termsOfService": "https://bandai-pats.example/terms"
		},
		"servers": [
			{
				"url": "/api",
				"description": "Development server"
			},
			{
				"url": "https://api.bandai-pats.example/api",
				"description": "Production server"
			}
		],
		"tags": [
			{
				"name": "Documentation",
				"description": "API documentation endpoints"
			}
		],
		"security": [
			{
				"bearerAuth": []
			}
		],
		"components": {
			"securitySchemes": {
				"bearerAuth": {
					"type": "http",
					"scheme": "bearer",
					"bearerFormat": "JWT",
					"description": "JWT Authorization header using the Bearer scheme. Example: 'Authorization: Bearer {token}'"
				},
				"apiKey": {
					"type": "apiKey",
					"in": "header",
					"name": "X-API-Key",
					"description": "API Key for authentication"
				}
			}
		}
	},
	"apis": [
		"./docs/models/*.yaml",
		"./app/docs/docs.router.ts",
		"./app/workspace/workspace.router.ts",
		"./app/workspaceMember/workspace-member.router.ts",
		"./app/projectMember/project-member.router.ts",
		"./app/employee/employee.router.ts",
		"./app/product/product.router.ts",
		"./app/pats/catalog.router.ts",
		"./app/pats/catalog-foundation.ts",
		"./app/pats/bom-foundation.ts",
		"./app/pats/process-route-foundation.ts",
		"./docs/openapi/2026-07-31-pats-api-v1-domain-reads.yaml",
		"./app/canonical/router.ts"
	]
}
