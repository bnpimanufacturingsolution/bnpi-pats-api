# Bandai PATS environment contract — DEV
# Single source for this environment's ports and mode; the compose stack and the future GitOps
# ConfigMap both derive from this file. Secrets do NOT live here.
PATS_ENV=dev
APP_PORT=3100
API_PORT=3101
DB_HOST_PORT=15433
SEED_MODE=demo
CORS_ORIGINS=http://localhost:3100
PATS_VERSION=dev
POSTGRES_DB=pats
POSTGRES_USER=pats
# Placeholder — replaced by the host secret bootstrap on a real appliance.
POSTGRES_PASSWORD=pats-dev-placeholder
